# The bench CI runner's settings (card H-105; RUNBOOK §13 part, docs/runbook/13-bench-ci-runner.md).
# Copy to /etc/tb-bench-ci/settings.env on the bench host (root:tb-bench, mode 0640) and fill every <...>:
# launcher.py check refuses a placeholder, an unknown key and a missing one. This file is never sourced by a shell.
# Nothing here is a secret: the minting token has its own root-only file (install.sh token).

# the repository whose train/* pushes the runner serves, and the label its jobs ask for
BENCH_REPO=<owner>/<repository>
BENCH_LABEL=tb-bench

# the job image install.sh builds, and the rootless engine that runs it (as the tb-bench user)
BENCH_IMAGE=localhost/tb-bench-runner:1
BENCH_ENGINE=<absolute path of the container engine>

# the first two numbers of a private /16 the host does not use: each slot's own job network is a /24 in it
BENCH_SUBNET_PREFIX=<a.b, e.g. 10.213>

# a folder made for CI scratch only (install.sh creates it, owned by tb-bench, mode 0700); never a folder of the
# bench, the walk, the datasets or the owner's home
BENCH_SCRATCH=<absolute path of an empty folder on a disk with room for the jobs>

# how many runners of each kind wait for a job (cpu: unit shards, integration; engine: a nested engine; gpu: jobs
# that share the CI cards, each checked against the cap below)
BENCH_CPU_SLOTS=<number>
BENCH_ENGINE_SLOTS=<number>
BENCH_GPU_SLOTS=<number>

# each job container's share of the host
BENCH_CPUS=<cores per job>
BENCH_MEMORY=<memory per job, e.g. 64g>
BENCH_PIDS=8192
BENCH_JOB_HOURS=6

# the jobs' one way out (the egress proxy): exact host names, port 443 only. The one suffix is the code host's own
# job service; the storage accounts are named one by one (no storage wildcard); no upload host, no user-content wildcard. The
# code host's API is one name for reads and writes: the jobs hold no write credential (master's workflow, which the
# gate holds them to, gives a read-only one)
BENCH_ALLOW_HOSTS=github.com,api.github.com,codeload.github.com,objects.githubusercontent.com,raw.githubusercontent.com,release-assets.githubusercontent.com,.actions.githubusercontent.com,productionresultssa0.blob.core.windows.net,productionresultssa1.blob.core.windows.net,productionresultssa2.blob.core.windows.net,productionresultssa3.blob.core.windows.net,productionresultssa4.blob.core.windows.net,productionresultssa5.blob.core.windows.net,productionresultssa6.blob.core.windows.net,productionresultssa7.blob.core.windows.net,productionresultssa8.blob.core.windows.net,productionresultssa9.blob.core.windows.net,productionresultssa10.blob.core.windows.net,productionresultssa11.blob.core.windows.net,productionresultssa12.blob.core.windows.net,productionresultssa13.blob.core.windows.net,productionresultssa14.blob.core.windows.net,productionresultssa15.blob.core.windows.net,productionresultssa16.blob.core.windows.net,productionresultssa17.blob.core.windows.net,productionresultssa18.blob.core.windows.net,productionresultssa19.blob.core.windows.net,pypi.org,files.pythonhosted.org,repo.maven.apache.org,repo1.maven.org,api.adoptium.net,packages.fhir.org,registry.npmjs.org,ghcr.io,pkg-containers.githubusercontent.com,registry-1.docker.io,auth.docker.io,production.cloudflare.docker.com

# the runner release install.sh downloads: its version and the SHA-256 its release page gives for linux-x64
BENCH_RUNNER_VERSION=<x.y.z>
BENCH_RUNNER_SHA256=<64 hex digits>

# the CI cards (only when BENCH_GPU_SLOTS is not 0). Never card 1 (the walk's), never a card of the bench: list
# both in BENCH_RESERVED_GPUS. The CI cards are shared by the GPU jobs; the cap is the most memory (MiB) and load
# (%) a CI card may already carry when a GPU job starts: above it (or unreadable) the job does not start
BENCH_CI_GPUS=<index>,<index>
BENCH_RESERVED_GPUS=1,<the bench's card indexes>
BENCH_GPU_QUERY=<absolute path of the card query tool>
BENCH_GPU_DEVICE=<the engine's device name prefix for one card, without =index>
BENCH_GPU_CAP_MIB=<MiB in use on a CI card above which a GPU job does not start>
BENCH_GPU_CAP_UTIL=<load in % on a CI card above which a GPU job does not start>
# the model weights on the host (the integrator's ruling of 2026-11-24 on H105-03), mounted read-only into GPU jobs at
# /weights; the version check uses their pinned hashes. Readable by tb-bench, writable by root only
BENCH_WEIGHTS=<absolute path of the weights folder>
