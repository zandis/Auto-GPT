# The bench CI runner's settings (card H-105; RUNBOOK §13 part, docs/runbook/13-bench-ci-runner.md).
# Copy to /etc/tb-bench-ci/settings.env on the bench host (root:tb-bench, mode 0640) and fill every <...>:
# launcher.py check refuses a placeholder, an unknown key and a missing one. This file is never sourced by a shell.
# Nothing here is a secret: the minting token has its own root-only file (install.sh token).

# the repository whose train/* pushes the runner serves, and the label its jobs ask for
TB_BENCH_REPO=<owner>/<repository>
TB_BENCH_LABEL=tb-bench

# the job image install.sh builds, and the rootless engine that runs it (as the tb-bench user)
TB_BENCH_IMAGE=localhost/tb-bench-runner:1
TB_BENCH_ENGINE=<absolute path of the container engine>

# a folder made for CI scratch only (install.sh creates it, owned by tb-bench, mode 0700); never a folder of the
# bench, the walk, the datasets or the owner's home
TB_BENCH_SCRATCH=<absolute path of an empty folder on a disk with room for the jobs>

# how many runners of each kind wait for a job (cpu: unit shards, integration; engine: a nested engine; gpu: 0 or 1)
TB_BENCH_CPU_SLOTS=<number>
TB_BENCH_ENGINE_SLOTS=<number>
TB_BENCH_GPU_SLOTS=<0 or 1>

# each job container's share of the host
TB_BENCH_CPUS=<cores per job>
TB_BENCH_MEMORY=<memory per job, e.g. 64g>
TB_BENCH_PIDS=8192
TB_BENCH_TMP_SIZE=16g
TB_BENCH_JOB_HOURS=6

# the jobs' one way out (the egress proxy): exact host names, or .suffix for any name under it; port 443 only
TB_BENCH_ALLOW_HOSTS=github.com,api.github.com,codeload.github.com,.githubusercontent.com,.blob.core.windows.net,pypi.org,files.pythonhosted.org,repo.maven.apache.org,repo1.maven.org,api.adoptium.net,packages.fhir.org,registry.npmjs.org

# the runner release install.sh downloads: its version and the SHA-256 its release page gives for linux-x64
TB_BENCH_RUNNER_VERSION=<x.y.z>
TB_BENCH_RUNNER_SHA256=<64 hex digits>

# the CI cards (only when TB_BENCH_GPU_SLOTS=1). Never card 1 (the walk's), never a card of the bench: list both
# in TB_BENCH_RESERVED_GPUS; launcher.py refuses a CI card that is reserved, missing or busy
TB_BENCH_CI_GPUS=<index>,<index>
TB_BENCH_RESERVED_GPUS=1,<the bench's card indexes>
TB_BENCH_GPU_QUERY=<absolute path of the card query tool>
TB_BENCH_GPU_DEVICE=<the engine's device name prefix for one card, without =index>
TB_BENCH_GPU_BUSY_MIB=1024
TB_BENCH_GPU_BUSY_UTIL=5
