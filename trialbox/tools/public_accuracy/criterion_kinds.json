{
 "schema_version": 1,
 "what": "The criterion kinds of the ladder report (card 10A-3): one row per kind, the rung that should answer it, and the regular expressions that tag a criterion's text with it (case-insensitive, multi-label; a criterion matching none is 'none'). Rough, for proportions only, like the classification of review 15 section 2.2 [M 3] it follows; it reads the protocol text only, never a patient.",
 "kinds": [
  {"kind": "age_sex", "label": "age or sex", "answer_by": "rules",
   "patterns": ["\\b(age[ds]?|aged|years? (of age|old)|yrs?|male|female|men|women|sex|gender)\\b", "歳", "年齢", "男性", "女性", "性別"]},
  {"kind": "diagnosis", "label": "diagnosis", "answer_by": "codes, then notes",
   "patterns": ["\\b(diagnos\\w*|disease|disorder|syndrome|cancer|carcinoma|tumou?r|infection|failure|patients? with|confirmed|histolog\\w*|illness|condition|acute|chronic|suspected)\\b", "診断", "病", "症", "がん", "癌", "腫瘍", "感染", "診斷"]},
  {"kind": "medication", "label": "medication", "answer_by": "codes, then notes",
   "patterns": ["\\b(drugs?|medications?|medicines?|therap(y|ies)|treat(ed|ment)|chemotherapy|doses?|dosing|antibiotics?|steroids?|insulin|aspirin|inhibitors?|agents?|receiv\\w*|taking|use of|administ\\w*|vaccin\\w*|anticoagul\\w*)\\b", "投与", "投薬", "薬", "治療", "藥", "化学療法"]},
  {"kind": "temporal", "label": "temporal wording", "answer_by": "rules",
   "patterns": ["\\b(within|prior to|before|after|since|days?|weeks?|months?|years?|hours?|previous(ly)?)\\b", "以内", "以前", "前", "後", "日", "週", "か月", "ヶ月", "年以内", "個月"]},
  {"kind": "history", "label": "\"no history of\" or \"history of\"", "answer_by": "codes for exclusions; notes with care",
   "patterns": ["\\bhistory\\b", "\\bnever\\b", "\\bno (known|prior|previous)\\b", "既往", "病歴", "病史"]},
  {"kind": "consent", "label": "consent and capacity", "answer_by": "person",
   "patterns": ["\\b(consent|capacity|willing|willingness|comprehend|cooperat\\w*|agree\\w*|understand\\w*|literate|competent)\\b", "\\bable to (give|sign|provide|understand|read|comply)\\b", "同意", "同意書"]},
  {"kind": "procedure_device", "label": "procedure or device", "answer_by": "codes, then notes",
   "patterns": ["\\b(surgery|surgical|procedures?|operations?|operat(ed|ive)|implant\\w*|devices?|pacemaker|catheter\\w*|transplant\\w*|ventilation|intubat\\w*|dialysis|stent\\w*|biopsy|resection|ablation|graft|valve|prosthe\\w*|CABG|PCI|bypass|radiotherapy|radiation|endoscop\\w*)\\b", "手術", "術", "透析", "移植", "放射線"]},
  {"kind": "lab", "label": "laboratory value", "answer_by": "rules",
   "patterns": ["\\b(levels?|serum|plasma|blood|creatinine|hemoglobin|haemoglobin|platelets?|counts?|bilirubin|ALT|AST|INR|TSH|HbA1c|glucose|mg/dl|mmol|g/dl|laboratory|ULN)\\b", "検査値", "血清", "血糖", "クレアチニン", "ヘモグロビン", "血小板"]},
  {"kind": "pregnancy", "label": "pregnancy and contraception", "answer_by": "person at the visit; codes for a recorded pregnancy",
   "patterns": ["\\b(pregnan\\w*|lactat\\w*|breast[- ]?feeding|nursing|contracept\\w*|childbearing|menopaus\\w*|postmenopaus\\w*|fertile|birth control)\\b", "妊娠", "授乳", "避妊", "懷孕", "哺乳"]},
  {"kind": "counts", "label": "counts and repetition", "answer_by": "rules",
   "patterns": ["\\b(at least|or more|times|episodes?|twice|more than)\\b", "回以上", "以上の"]},
  {"kind": "vital", "label": "vital sign or measure", "answer_by": "rules",
   "patterns": ["\\b(blood pressure|heart rate|respiratory rate|BMI|body mass index|weight|height|temperature|oxygen|saturation|SpO2|PaO2|hypoxemia|systolic|diastolic|mmHg|pulse)\\b", "血圧[値がは]", "収縮期", "体重", "身長", "脈拍", "體重"]},
  {"kind": "lifestyle", "label": "lifestyle", "answer_by": "notes, then person",
   "patterns": ["\\b(smok\\w*|alcohol\\w*|drink\\w*|tobacco|cigarettes?|substance|abuse|illicit|addict\\w*|exercise|diet)\\b", "喫煙", "飲酒", "吸菸", "喝酒"]},
  {"kind": "scale_stage", "label": "scale or stage", "answer_by": "rules on coded or templated values, then notes",
   "patterns": ["\\b(score|scale|stage|grade|ECOG|Karnofsky|NYHA|GCS|class|MMSE)\\b", "病期", "ステージ", "スコア", "分期"]},
  {"kind": "allergy", "label": "allergy", "answer_by": "codes (allergy list), then notes",
   "patterns": ["\\b(allerg\\w*|hypersensitiv\\w*|intoleran\\w*|anaphyla\\w*|contraindicat\\w*)\\b", "アレルギー", "過敏", "禁忌", "過敏症"]},
  {"kind": "imaging", "label": "imaging", "answer_by": "report extractor rules, then judge",
   "patterns": ["\\b(MRI|x-?ray|ultrasound|echocardiogra\\w*|imaging|radiograph\\w*|angiogra\\w*)\\b", "\\bCT\\b", "画像", "超音波", "影像"]},
  {"kind": "another_study", "label": "another study", "answer_by": "the box's own enrolment records, then person",
   "patterns": ["\\b(other (clinical )?(study|trial)|another (study|trial)|investigational|participat\\w* in)\\b", "他の治験", "臨床試験に参加"]},
  {"kind": "judgement", "label": "investigator judgement", "answer_by": "person, never a model",
   "patterns": ["\\b(investigator|opinion|judg(e)?ment|physician|clinician|doctor|discretion|deem\\w*|unsuitable|inappropriate)\\b", "医師が", "不適当", "不適切", "醫師"]},
  {"kind": "logistics", "label": "study logistics", "answer_by": "person",
   "patterns": ["\\b(follow[- ]up|travel|reside\\w*|transport\\w*|attend|geographic\\w*|distance)\\b", "来院", "通院"]},
  {"kind": "biomarker", "label": "biomarker", "answer_by": "structured genomic report, then notes",
   "patterns": ["\\b(EGFR|HER2|KRAS|BRAF|ALK|PD-?L1|mutation\\w*|biomarker|genotyp\\w*|genes?|genetic|HLA|marker)\\b", "遺伝子", "変異", "基因"]}
 ]
}
