  TB.LatestObs("Q_RA-BIO-REN-01_1_crp")

define "V_RA-BIO-REN-01_1":
  TB.DAS28(TB.ObsValue("L_RA-BIO-REN-01_1_tjc28"), TB.ObsValue("L_RA-BIO-REN-01_1_sjc28"), TB.ObsValue("L_RA-BIO-REN-01_1_ptga"), TB.ObsValue("L_RA-BIO-REN-01_1_esr"), TB.ObsValue("L_RA-BIO-REN-01_1_crp"))

define "A_RA-BIO-REN-01_1":
  ("V_RA-BIO-REN-01_1" >= 0)

define "EA_RA-BIO-REN-01_1":
  Flatten({ if "L_RA-BIO-REN-01_1_tjc28" is null then List<String>{} else { "L_RA-BIO-REN-01_1_tjc28".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_tjc28")) }, if "L_RA-BIO-REN-01_1_sjc28" is null then List<String>{} else { "L_RA-BIO-REN-01_1_sjc28".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_sjc28")) }, if "L_RA-BIO-REN-01_1_ptga" is null then List<String>{} else { "L_RA-BIO-REN-01_1_ptga".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_ptga")) }, if "L_RA-BIO-REN-01_1_esr" is null then List<String>{} else { "L_RA-BIO-REN-01_1_esr".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_esr")) }, if "L_RA-BIO-REN-01_1_crp" is null then List<String>{} else { "L_RA-BIO-REN-01_1_crp".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_crp")) } })

/* RA-BIO-REN-01 (renewal): 續用申請前九十日內須有完整之 DAS28 評估。 */
define "C_RA-BIO-REN-01":
  "A_RA-BIO-REN-01_1"

define "E_RA-BIO-REN-01":
  Flatten({ "EA_RA-BIO-REN-01_1" })

define "Q_RA-BIO-DOC-01_1":
  [Observation: "VS_HBSAG"] X where TB.ObsDate(X) in Interval[IndexDate - 365 days, IndexDate]

define "A_RA-BIO-DOC-01_1":
  exists ("Q_RA-BIO-DOC-01_1")

define "EA_RA-BIO-DOC-01_1":
  "Q_RA-BIO-DOC-01_1" X return X.id + '|' + ToString(TB.ObsDate(X))

/* RA-BIO-DOC-01 (documentation): 一年內B型肝炎表面抗原（HBsAg）檢驗報告。 */
define "C_RA-BIO-DOC-01":
  "A_RA-BIO-DOC-01_1"

define "E_RA-BIO-DOC-01":
  Flatten({ "EA_RA-BIO-DOC-01_1" })

define "Q_RA-BIO-DOC-02_1":
  [Observation: "VS_ANTI_HBC"] X where TB.ObsDate(X) in Interval[IndexDate - 365 days, IndexDate]

define "A_RA-BIO-DOC-02_1":
  exists ("Q_RA-BIO-DOC-02_1")

define "EA_RA-BIO-DOC-02_1":
  "Q_RA-BIO-DOC-02_1" X return X.id + '|' + ToString(TB.ObsDate(X))

/* RA-BIO-DOC-02 (documentation): 一年內B型肝炎核心抗體（anti-HBc）檢驗報告。 */
define "C_RA-BIO-DOC-02":
  "A_RA-BIO-DOC-02_1"

define "E_RA-BIO-DOC-02":
  Flatten({ "EA_RA-BIO-DOC-02_1" })

define "Q_RA-BIO-DOC-03_1":
  [Observation: "VS_IGRA"] X where TB.ObsDate(X) in Interval[IndexDate - 180 days, IndexDate]

define "A_RA-BIO-DOC-03_1":
  exists ("Q_RA-BIO-DOC-03_1")

define "EA_RA-BIO-DOC-03_1":
  "Q_RA-BIO-DOC-03_1" X return X.id + '|' + ToString(TB.ObsDate(X))

define "Q_RA-BIO-DOC-03_2":
  [DiagnosticReport: "VS_CHEST_X_RAY"] X where date from (X.effective as FHIR.dateTime) in Interval[IndexDate - 180 days, IndexDate]

define "A_RA-BIO-DOC-03_2":
  exists ("Q_RA-BIO-DOC-03_2")

define "EA_RA-BIO-DOC-03_2":
  "Q_RA-BIO-DOC-03_2" X return X.id + '|' + ToString(date from (X.effective as FHIR.dateTime))

/* RA-BIO-DOC-03 (documentation): 六個月內結核篩檢：丙型干擾素釋放試驗（IGRA）或胸部X光報告。 */
define "C_RA-BIO-DOC-03":
  ("A_RA-BIO-DOC-03_1" or "A_RA-BIO-DOC-03_2")

define "E_RA-BIO-DOC-03":
  Flatten({ "EA_RA-BIO-DOC-03_1", "EA_RA-BIO-DOC-03_2" })

define "Q_RA-BIO-DOC-04_1":
  [Observation: "VS_ESR_OR_CRP"] X where TB.ObsDate(X) in Interval[IndexDate - 90 days, IndexDate]

define "A_RA-BIO-DOC-04_1":
  exists ("Q_RA-BIO-DOC-04_1")

define "EA_RA-BIO-DOC-04_1":
  "Q_RA-BIO-DOC-04_1" X return X.id + '|' + ToString(TB.ObsDate(X))

/* RA-BIO-DOC-04 (documentation): 九十日內紅血球沉降速率（ESR）或C反應蛋白（CRP）檢驗報告。 */
define "C_RA-BIO-DOC-04":
  "A_RA-BIO-DOC-04_1"

define "E_RA-BIO-DOC-04":
  Flatten({ "EA_RA-BIO-DOC-04_1" })

