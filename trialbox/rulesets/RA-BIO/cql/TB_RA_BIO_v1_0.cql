define "Q_RA-BIO-EXC-01_1":
  [Condition: "VS_ACTIVE_TUBERCULOSIS"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[IndexDate - 365 days, IndexDate]

