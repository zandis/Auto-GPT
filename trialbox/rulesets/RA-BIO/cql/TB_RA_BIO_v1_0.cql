  [Condition: "VS_ACTIVE_TUBERCULOSIS"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null

define "O_RA-BIO-EXC-01_1":
  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[IndexDate - 365 days, IndexDate])
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A15')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A16')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A17')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A18')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A19'))) and not (FHIRHelpers.ToCode(Cd) in "VS_ACTIVE_TUBERCULOSIS"))

define "UO_RA-BIO-EXC-01_1":
  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null)
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A15')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A16')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A17')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A18')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'A19'))) and not (FHIRHelpers.ToCode(Cd) in "VS_ACTIVE_TUBERCULOSIS"))

define "A_RA-BIO-EXC-01_1":
  if exists ("Q_RA-BIO-EXC-01_1") then true else if exists ("O_RA-BIO-EXC-01_1") then null as Boolean else if exists ("U_RA-BIO-EXC-01_1") or exists ("UO_RA-BIO-EXC-01_1") then null as Boolean else false

define "EA_RA-BIO-EXC-01_1":
  if exists ("Q_RA-BIO-EXC-01_1") then ("Q_RA-BIO-EXC-01_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate))) else ("O_RA-BIO-EXC-01_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate)))

