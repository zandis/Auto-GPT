define "Q_RA-BIO-REN-01_1_tjc28":
  [Observation: "TB code tjc28"] X where TB.ObsDate(X) in Interval[IndexDate - 90 days, IndexDate]

define "L_RA-BIO-REN-01_1_tjc28":
  TB.LatestObs("Q_RA-BIO-REN-01_1_tjc28")

define "K_RA-BIO-REN-01_1_tjc28":
  if TB."Conv_tjc28"("L_RA-BIO-REN-01_1_tjc28") >= 0.0 and TB."Conv_tjc28"("L_RA-BIO-REN-01_1_tjc28") <= 28.0 then TB."Conv_tjc28"("L_RA-BIO-REN-01_1_tjc28") else null

define "Q_RA-BIO-REN-01_1_sjc28":
  [Observation: "TB code sjc28"] X where TB.ObsDate(X) in Interval[IndexDate - 90 days, IndexDate] and TB.SameVisit(X, "L_RA-BIO-REN-01_1_tjc28", 0)

define "L_RA-BIO-REN-01_1_sjc28":
  TB.LatestObs("Q_RA-BIO-REN-01_1_sjc28")

define "K_RA-BIO-REN-01_1_sjc28":
  if TB."Conv_sjc28"("L_RA-BIO-REN-01_1_sjc28") >= 0.0 and TB."Conv_sjc28"("L_RA-BIO-REN-01_1_sjc28") <= 28.0 then TB."Conv_sjc28"("L_RA-BIO-REN-01_1_sjc28") else null

define "Q_RA-BIO-REN-01_1_ptga":
  [Observation: "TB code ptga"] X where TB.ObsDate(X) in Interval[IndexDate - 90 days, IndexDate] and TB.SameVisit(X, "L_RA-BIO-REN-01_1_tjc28", 0)

define "L_RA-BIO-REN-01_1_ptga":
  TB.LatestObs("Q_RA-BIO-REN-01_1_ptga")

define "K_RA-BIO-REN-01_1_ptga":
  TB."Conv_ptga"("L_RA-BIO-REN-01_1_ptga")

define "Q_RA-BIO-REN-01_1_esr":
  [Observation: "TB code esr"] X where TB.ObsDate(X) in Interval[IndexDate - 90 days, IndexDate] and TB.SameVisit(X, "L_RA-BIO-REN-01_1_tjc28", 7)

define "L_RA-BIO-REN-01_1_esr":
  TB.LatestObs("Q_RA-BIO-REN-01_1_esr")

define "K_RA-BIO-REN-01_1_esr":
  if TB."Conv_esr"("L_RA-BIO-REN-01_1_esr") >= 0.0 then TB."Conv_esr"("L_RA-BIO-REN-01_1_esr") else null

define "Q_RA-BIO-REN-01_1_crp":
  [Observation: "TB code crp"] X where TB.ObsDate(X) in Interval[IndexDate - 90 days, IndexDate] and TB.SameVisit(X, "L_RA-BIO-REN-01_1_tjc28", 7)

define "L_RA-BIO-REN-01_1_crp":
  TB.LatestObs("Q_RA-BIO-REN-01_1_crp")

define "K_RA-BIO-REN-01_1_crp":
  if TB."Conv_crp"("L_RA-BIO-REN-01_1_crp") >= 0.0 then TB."Conv_crp"("L_RA-BIO-REN-01_1_crp") else null

define "V_RA-BIO-REN-01_1":
  TB.DAS28("K_RA-BIO-REN-01_1_tjc28", "K_RA-BIO-REN-01_1_sjc28", "K_RA-BIO-REN-01_1_ptga", "L_RA-BIO-REN-01_1_esr" is not null, "K_RA-BIO-REN-01_1_esr", "K_RA-BIO-REN-01_1_crp")

define "A_RA-BIO-REN-01_1":
  ("V_RA-BIO-REN-01_1" >= 0)

define "EA_RA-BIO-REN-01_1":
  Flatten({ if "L_RA-BIO-REN-01_1_tjc28" is null then List<String>{} else { "L_RA-BIO-REN-01_1_tjc28".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_tjc28")) }, if "L_RA-BIO-REN-01_1_sjc28" is null then List<String>{} else { "L_RA-BIO-REN-01_1_sjc28".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_sjc28")) }, if "L_RA-BIO-REN-01_1_ptga" is null then List<String>{} else { "L_RA-BIO-REN-01_1_ptga".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_ptga")) }, if "L_RA-BIO-REN-01_1_esr" is null then List<String>{} else { "L_RA-BIO-REN-01_1_esr".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_esr")) }, if "L_RA-BIO-REN-01_1_crp" is null then List<String>{} else { "L_RA-BIO-REN-01_1_crp".id + '|' + ToString(TB.ObsDate("L_RA-BIO-REN-01_1_crp")) } })

