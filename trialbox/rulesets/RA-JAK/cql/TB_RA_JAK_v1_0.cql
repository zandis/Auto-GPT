    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10' and StartsWith(Cd.code.value, 'C97')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C0')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C1')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C2')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C3')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C40')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C41')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C43')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C44')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C45')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C46')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C47')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C48')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C49')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C4A')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C5')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C6')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C7')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C8')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'C9')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'D45')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'D46')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'D47')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'Z85'))) and not (FHIRHelpers.ToCode(Cd) in "VS_MALIGNANCY"))

define "A_RA-JAK-EXC-08_1":
  if exists ("Q_RA-JAK-EXC-08_1") then true else if exists ("O_RA-JAK-EXC-08_1") then null as Boolean else if exists ("U_RA-JAK-EXC-08_1") or exists ("UO_RA-JAK-EXC-08_1") then null as Boolean else false

define "EA_RA-JAK-EXC-08_1":
  if exists ("Q_RA-JAK-EXC-08_1") then ("Q_RA-JAK-EXC-08_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate))) else ("O_RA-JAK-EXC-08_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate)))

/* RA-JAK-EXC-08 (exclusion): Malignancy within the past 5 years. */
define "C_RA-JAK-EXC-08":
  "A_RA-JAK-EXC-08_1"

define "E_RA-JAK-EXC-08":
  Flatten({ "EA_RA-JAK-EXC-08_1" })

define "Q_RA-JAK-EXC-09_1":
  [Condition: "VS_HEART_FAILURE"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[@1900-01-01, IndexDate]

define "U_RA-JAK-EXC-09_1":
  [Condition: "VS_HEART_FAILURE"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null

define "O_RA-JAK-EXC-09_1":
  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[@1900-01-01, IndexDate])
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'I50'))) and not (FHIRHelpers.ToCode(Cd) in "VS_HEART_FAILURE"))

define "UO_RA-JAK-EXC-09_1":
  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null)
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'I50'))) and not (FHIRHelpers.ToCode(Cd) in "VS_HEART_FAILURE"))

define "A_RA-JAK-EXC-09_1":
  if exists ("Q_RA-JAK-EXC-09_1") then true else if exists ("O_RA-JAK-EXC-09_1") then null as Boolean else if exists ("U_RA-JAK-EXC-09_1") or exists ("UO_RA-JAK-EXC-09_1") then null as Boolean else false

define "EA_RA-JAK-EXC-09_1":
  if exists ("Q_RA-JAK-EXC-09_1") then ("Q_RA-JAK-EXC-09_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate))) else ("O_RA-JAK-EXC-09_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate)))

/* RA-JAK-EXC-09 (exclusion): Heart failure (NYHA class III or IV). */
define "C_RA-JAK-EXC-09":
  "A_RA-JAK-EXC-09_1"

define "E_RA-JAK-EXC-09":
  Flatten({ "EA_RA-JAK-EXC-09_1" })

define "Q_RA-JAK-EXC-10_1":
  [Condition: "VS_PREGNANCY"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[IndexDate - 280 days, IndexDate]

define "U_RA-JAK-EXC-10_1":
  [Condition: "VS_PREGNANCY"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null

define "O_RA-JAK-EXC-10_1":
  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[IndexDate - 280 days, IndexDate])
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'O'))) and not (FHIRHelpers.ToCode(Cd) in "VS_PREGNANCY"))

define "UO_RA-JAK-EXC-10_1":
  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null)
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'O'))) and not (FHIRHelpers.ToCode(Cd) in "VS_PREGNANCY"))

define "A_RA-JAK-EXC-10_1":
  if exists ("Q_RA-JAK-EXC-10_1") then true else if exists ("O_RA-JAK-EXC-10_1") then null as Boolean else if exists ("U_RA-JAK-EXC-10_1") or exists ("UO_RA-JAK-EXC-10_1") then null as Boolean else false

define "EA_RA-JAK-EXC-10_1":
  if exists ("Q_RA-JAK-EXC-10_1") then ("Q_RA-JAK-EXC-10_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate))) else ("O_RA-JAK-EXC-10_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate)))

/* RA-JAK-EXC-10 (exclusion): Pregnancy (a pregnancy diagnosis within 280 days). */
define "C_RA-JAK-EXC-10":
  "A_RA-JAK-EXC-10_1"

define "E_RA-JAK-EXC-10":
  Flatten({ "EA_RA-JAK-EXC-10_1" })

define "Q_RA-JAK-EXC-11_1_creatinine":
  [Observation: "TB code creatinine"] X where TB.ObsDate(X) in Interval[IndexDate - 365 days, IndexDate]

define "L_RA-JAK-EXC-11_1_creatinine":
  TB.LatestObs("Q_RA-JAK-EXC-11_1_creatinine")

define "K_RA-JAK-EXC-11_1_creatinine":
  if TB."Conv_creatinine"("L_RA-JAK-EXC-11_1_creatinine") > 0.0 then TB."Conv_creatinine"("L_RA-JAK-EXC-11_1_creatinine") else null

define "V_RA-JAK-EXC-11_1":
  TB.EGFR2021("K_RA-JAK-EXC-11_1_creatinine", TB.AgeAt(Patient, IndexDate), TB.IsFemale(Patient))

define "A_RA-JAK-EXC-11_1":
  ("V_RA-JAK-EXC-11_1" < 40)

define "EA_RA-JAK-EXC-11_1":
  Flatten({ if "L_RA-JAK-EXC-11_1_creatinine" is null then List<String>{} else { "L_RA-JAK-EXC-11_1_creatinine".id + '|' + ToString(TB.ObsDate("L_RA-JAK-EXC-11_1_creatinine")) } })

/* RA-JAK-EXC-11 (exclusion): Estimated GFR below 40 mL/min/1.73 m² (CKD-EPI 2021) at screening. */
define "C_RA-JAK-EXC-11":
  "A_RA-JAK-EXC-11_1"

define "E_RA-JAK-EXC-11":
  Flatten({ "EA_RA-JAK-EXC-11_1" })

