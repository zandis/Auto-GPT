  Flatten({ "EA_GOUT-COH-INC-06_1" })

define "Q_GOUT-COH-INC-07_1":
  [Condition: "VS_TYPE_2_DIABETES_MELLITUS"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[@1900-01-01, IndexDate]

define "U_GOUT-COH-INC-07_1":
  [Condition: "VS_TYPE_2_DIABETES_MELLITUS"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null

define "O_GOUT-COH-INC-07_1":
  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[@1900-01-01, IndexDate])
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10' and StartsWith(Cd.code.value, 'E14')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'E11'))) and not (FHIRHelpers.ToCode(Cd) in "VS_TYPE_2_DIABETES_MELLITUS"))

define "UO_GOUT-COH-INC-07_1":
  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null)
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10' and StartsWith(Cd.code.value, 'E14')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'E11'))) and not (FHIRHelpers.ToCode(Cd) in "VS_TYPE_2_DIABETES_MELLITUS"))

define "A_GOUT-COH-INC-07_1":
  if exists ("Q_GOUT-COH-INC-07_1") then true else if exists ("O_GOUT-COH-INC-07_1") then null as Boolean else if exists ("U_GOUT-COH-INC-07_1") or exists ("UO_GOUT-COH-INC-07_1") then null as Boolean else false

define "EA_GOUT-COH-INC-07_1":
  if exists ("Q_GOUT-COH-INC-07_1") then ("Q_GOUT-COH-INC-07_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate))) else ("O_GOUT-COH-INC-07_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate)))

/* GOUT-COH-INC-07 (inclusion): 合併第二型糖尿病診斷。 */
define "C_GOUT-COH-INC-07":
  "A_GOUT-COH-INC-07_1"

define "E_GOUT-COH-INC-07":
  Flatten({ "EA_GOUT-COH-INC-07_1" })

