define function "N_GZQO-EXC-06_1"(Q FHIR.Quantity, Cd List<FHIR.Coding>):
  case
    when TB.UnitKey(Q) = '%' then Q.value.value
    else null end

define "Q_GZQO-EXC-06_1":
  [Observation: "VS_HBA1C"] X where TB.ObsDate(X) in Interval[IndexDate - 180 days, IndexDate]

define "U_GZQO-EXC-06_1":
  [Observation: "VS_HBA1C"] X where (X.effective is null or (X.effective is FHIR.Period and (X.effective as FHIR.Period).start is null))

define "L_GZQO-EXC-06_1":
  TB.LatestObs("Q_GZQO-EXC-06_1")

define "A_GZQO-EXC-06_1":
  if "L_GZQO-EXC-06_1" is null then null as Boolean else if ((case when ("L_GZQO-EXC-06_1".value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_GZQO-EXC-06_1"("L_GZQO-EXC-06_1".value as FHIR.Quantity, "L_GZQO-EXC-06_1".code.coding) <= 10 then false else null) when ("L_GZQO-EXC-06_1".value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_GZQO-EXC-06_1"("L_GZQO-EXC-06_1".value as FHIR.Quantity, "L_GZQO-EXC-06_1".code.coding) > 10 then true else null) else ("N_GZQO-EXC-06_1"("L_GZQO-EXC-06_1".value as FHIR.Quantity, "L_GZQO-EXC-06_1".code.coding) > 10) end)) is true and not exists ("U_GZQO-EXC-06_1" X where ((case when (X.value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_GZQO-EXC-06_1"(X.value as FHIR.Quantity, X.code.coding) <= 10 then false else null) when (X.value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_GZQO-EXC-06_1"(X.value as FHIR.Quantity, X.code.coding) > 10 then true else null) else ("N_GZQO-EXC-06_1"(X.value as FHIR.Quantity, X.code.coding) > 10) end)) is not true) then true else if ((case when ("L_GZQO-EXC-06_1".value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_GZQO-EXC-06_1"("L_GZQO-EXC-06_1".value as FHIR.Quantity, "L_GZQO-EXC-06_1".code.coding) <= 10 then false else null) when ("L_GZQO-EXC-06_1".value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_GZQO-EXC-06_1"("L_GZQO-EXC-06_1".value as FHIR.Quantity, "L_GZQO-EXC-06_1".code.coding) > 10 then true else null) else ("N_GZQO-EXC-06_1"("L_GZQO-EXC-06_1".value as FHIR.Quantity, "L_GZQO-EXC-06_1".code.coding) > 10) end)) is false and not exists ("U_GZQO-EXC-06_1" X where ((case when (X.value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_GZQO-EXC-06_1"(X.value as FHIR.Quantity, X.code.coding) <= 10 then false else null) when (X.value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_GZQO-EXC-06_1"(X.value as FHIR.Quantity, X.code.coding) > 10 then true else null) else ("N_GZQO-EXC-06_1"(X.value as FHIR.Quantity, X.code.coding) > 10) end)) is not false) then false else null as Boolean

define "EA_GZQO-EXC-06_1":
