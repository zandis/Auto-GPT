    where Coalesce(date from start of FHIRHelpers.ToInterval(X.dispenseRequest.validityPeriod), date from X.authoredOn) is not null and s <= e
    return Interval[s, e]

define "D_GZQO-INC-06_1":
  Coalesce(Max((collapse ("P_GZQO-INC-06_1" I return Interval[start of I, end of I + 30 days]) per day) J
    return (days between start of J and (end of J - 30 days)) + 1), 0)

define "O_GZQO-INC-06_1":
  "Q_GZQO-INC-06_1" X
    where Coalesce(date from X.dispenseRequest.validityPeriod.start, date from X.authoredOn) is null
      or (X.dispenseRequest.validityPeriod.end is null and Coalesce(date from X.dispenseRequest.validityPeriod.start, date from X.authoredOn) <= IndexDate)

define "A_GZQO-INC-06_1":
  if "D_GZQO-INC-06_1" >= 90 then true else if exists ("O_GZQO-INC-06_1") then null as Boolean else false

define "EA_GZQO-INC-06_1":
  "Q_GZQO-INC-06_1" X return X.id + '|' + ToString(date from X.authoredOn)

/* GZQO-INC-06 (inclusion): Receiving stable urate-lowering therapy for at least 3 months (continuous within the past 6 months, gaps ≤30 days). */
define "C_GZQO-INC-06":
  "A_GZQO-INC-06_1"

define "E_GZQO-INC-06":
  Flatten({ "EA_GZQO-INC-06_1" })

define "Q_GZQO-INC-08_1_creatinine":
