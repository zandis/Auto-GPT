define function "TP_GZQO-EXC-04_1"(X FHIR.MedicationRequest):
  if (First(X.dosageInstruction).timing.repeat.bounds as FHIR.Period).start is not null or (First(X.dosageInstruction).timing.repeat.bounds as FHIR.Period).end is not null then (First(X.dosageInstruction).timing.repeat.bounds as FHIR.Period)
  else X.dispenseRequest.validityPeriod

define function "SD_GZQO-EXC-04_1"(X FHIR.MedicationRequest):
  if X.dispenseRequest.expectedSupplyDuration.value.value >= 0 then Truncate(X.dispenseRequest.expectedSupplyDuration.value.value * (case when Matches(Lower(Coalesce(X.dispenseRequest.expectedSupplyDuration.code.value, X.dispenseRequest.expectedSupplyDuration.unit.value)), '^ *(d|day|days) *$') then 1.0 when Matches(Lower(Coalesce(X.dispenseRequest.expectedSupplyDuration.code.value, X.dispenseRequest.expectedSupplyDuration.unit.value)), '^ *(wk|week|weeks) *$') then 7.0 else null end)) else null

define function "TS_GZQO-EXC-04_1"(X FHIR.MedicationRequest):
  Coalesce(date from "TP_GZQO-EXC-04_1"(X).start, date from X.authoredOn)

define function "TE_GZQO-EXC-04_1"(X FHIR.MedicationRequest):
  Coalesce(date from "TP_GZQO-EXC-04_1"(X).end, if "SD_GZQO-EXC-04_1"(X) is null then null
    else "TS_GZQO-EXC-04_1"(X) + System.Quantity { value: ToDecimal("SD_GZQO-EXC-04_1"(X)), unit: 'day' })

define "Q_GZQO-EXC-04_1":
  [MedicationRequest: "VS_GLP_1_RECEPTOR_AGONIST"] X where (date from X.authoredOn in Interval[IndexDate - 90 days, IndexDate] or (date from X.authoredOn is not null and "TE_GZQO-EXC-04_1"(X) >= IndexDate - 90 days and "TS_GZQO-EXC-04_1"(X) <= IndexDate))

define "U_GZQO-EXC-04_1":
  [MedicationRequest: "VS_GLP_1_RECEPTOR_AGONIST"] X where date from X.authoredOn is null

define "O_GZQO-EXC-04_1":
  [MedicationRequest] X where ((date from X.authoredOn in Interval[IndexDate - 90 days, IndexDate] or (date from X.authoredOn is not null and "TE_GZQO-EXC-04_1"(X) >= IndexDate - 90 days and "TS_GZQO-EXC-04_1"(X) <= IndexDate)))
    and exists (((X.medication as FHIR.CodeableConcept).coding) Cd where ((Cd.system.value = 'http://www.whocc.no/atc' and StartsWith(Cd.code.value, 'A10BJ'))) and not (FHIRHelpers.ToCode(Cd) in "VS_GLP_1_RECEPTOR_AGONIST"))

define "UO_GZQO-EXC-04_1":
  [MedicationRequest] X where (date from X.authoredOn is null)
    and exists (((X.medication as FHIR.CodeableConcept).coding) Cd where ((Cd.system.value = 'http://www.whocc.no/atc' and StartsWith(Cd.code.value, 'A10BJ'))) and not (FHIRHelpers.ToCode(Cd) in "VS_GLP_1_RECEPTOR_AGONIST"))

define "A_GZQO-EXC-04_1":
  if exists ("Q_GZQO-EXC-04_1") then true else if exists ("O_GZQO-EXC-04_1") then null as Boolean else if exists ("U_GZQO-EXC-04_1") or exists ("UO_GZQO-EXC-04_1") then null as Boolean else false

define "EA_GZQO-EXC-04_1":
  if exists ("Q_GZQO-EXC-04_1") then ("Q_GZQO-EXC-04_1" X return X.id + '|' + ToString(date from X.authoredOn)) else ("O_GZQO-EXC-04_1" X return X.id + '|' + ToString(date from X.authoredOn))

