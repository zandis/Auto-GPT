-cm' and StartsWith(Cd.code.value, 'D46')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'D47')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'Z85'))) and not (FHIRHelpers.ToCode(Cd) in "VS_MALIGNANCY_EXCEPT_NON_MELANOMA_SKIN_CANCER"))

