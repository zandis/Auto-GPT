  [Condition] X where (date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[@1900-01-01, IndexDate])
    and exists ((X.code.coding) Cd where ((Cd.system.value = 'http://hl7.org/fhir/sid/icd-10' and StartsWith(Cd.code.value, 'E14')) or (Cd.system.value = 'http://hl7.org/fhir/sid/icd-10-cm' and StartsWith(Cd.code.value, 'E10'))) and not (FHIRHelpers.ToCode(Cd) in "VS_TYPE_1_DIABETES_MELLITUS"))

