define function "N_GZQO-EXC-13_1"(Q FHIR.Quantity, Cd List<FHIR.Coding>):
  case
    when TB.UnitKey(Q) = 'u/l' then Q.value.value
    when TB.UnitKey(Q) = 'mu/ml' then Round(Q.value.value * 1.0, 6)
    when TB.UnitKey(Q) = 'u/ml' then Round(Q.value.value * 1000.0, 6)
    else null end

