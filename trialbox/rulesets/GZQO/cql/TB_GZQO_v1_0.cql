define "V_GZQO-INC-08_1":
  TB.EGFR2021("K_GZQO-INC-08_1_creatinine", TB.AgeAt(Patient, IndexDate), TB.IsFemale(Patient))

define "A_GZQO-INC-08_1":
  ("V_GZQO-INC-08_1" >= 30)

define "EA_GZQO-INC-08_1":
  Flatten({ if "L_GZQO-INC-08_1_creatinine" is null then List<String>{} else { "L_GZQO-INC-08_1_creatinine".id + '|' + ToString(TB.ObsDate("L_GZQO-INC-08_1_creatinine")) } })

