  Flatten({ "EA_GZQO-EXC-10_1", "EA_GZQO-EXC-10_2" })

define "Q_GZQO-EXC-13_1":
  [Observation: "VS_ALT"] X where TB.ObsDate(X) in Interval[IndexDate - 180 days, IndexDate]

define "L_GZQO-EXC-13_1":
  TB.LatestObs("Q_GZQO-EXC-13_1")

define "A_GZQO-EXC-13_1":
  if "L_GZQO-EXC-13_1" is null then null else (TB.ObsValue("L_GZQO-EXC-13_1") > 120)

define "EA_GZQO-EXC-13_1":
  if "L_GZQO-EXC-13_1" is null then List<String>{} else { "L_GZQO-EXC-13_1".id + '|' + ToString(TB.ObsDate("L_GZQO-EXC-13_1")) }

/* GZQO-EXC-13 (exclusion): ALT >3× upper limit of normal (>120 U/L) at screening. */
define "C_GZQO-EXC-13":
  "A_GZQO-EXC-13_1"

define "E_GZQO-EXC-13":
  Flatten({ "EA_GZQO-EXC-13_1" })

