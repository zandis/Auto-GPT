  Flatten({ if "L_RA-COH-INC-04_1_tjc28" is null then List<String>{} else { "L_RA-COH-INC-04_1_tjc28".id + '|' + ToString(TB.ObsDate("L_RA-COH-INC-04_1_tjc28")) }, if "L_RA-COH-INC-04_1_sjc28" is null then List<String>{} else { "L_RA-COH-INC-04_1_sjc28".id + '|' + ToString(TB.ObsDate("L_RA-COH-INC-04_1_sjc28")) }, if "L_RA-COH-INC-04_1_ptga" is null then List<String>{} else { "L_RA-COH-INC-04_1_ptga".id + '|' + ToString(TB.ObsDate("L_RA-COH-INC-04_1_ptga")) }, if "L_RA-COH-INC-04_1_esr" is null then List<String>{} else { "L_RA-COH-INC-04_1_esr".id + '|' + ToString(TB.ObsDate("L_RA-COH-INC-04_1_esr")) }, if "L_RA-COH-INC-04_1_crp" is null then List<String>{} else { "L_RA-COH-INC-04_1_crp".id + '|' + ToString(TB.ObsDate("L_RA-COH-INC-04_1_crp")) } })

/* RA-COH-INC-04 (inclusion): 九十日內最近一次 DAS28 小於或等於 3.2（低疾病活動度）。 */
define "C_RA-COH-INC-04":
  "A_RA-COH-INC-04_1"

define "E_RA-COH-INC-04":
  Flatten({ "EA_RA-COH-INC-04_1" })

define "Q_RA-COH-INC-05_1":
  [Observation: "VS_HBSAG"] X where TB.ObsDate(X) in Interval[@1900-01-01, IndexDate]

define "U_RA-COH-INC-05_1":
  [Observation: "VS_HBSAG"] X where (X.effective is null or (X.effective is FHIR.Period and (X.effective as FHIR.Period).start is null))

define "L_RA-COH-INC-05_1":
  TB.LatestObs("Q_RA-COH-INC-05_1")

define "A_RA-COH-INC-05_1":
  if "L_RA-COH-INC-05_1" is null then null as Boolean else if ((TB.ObsCode("L_RA-COH-INC-05_1") in { 'LA6576-8' })) is true and not exists ("U_RA-COH-INC-05_1" X where ((TB.ObsCode(X) in { 'LA6576-8' })) is not true) then true else if ((TB.ObsCode("L_RA-COH-INC-05_1") in { 'LA6576-8' })) is false and not exists ("U_RA-COH-INC-05_1" X where ((TB.ObsCode(X) in { 'LA6576-8' })) is not false) then false else null as Boolean

define "EA_RA-COH-INC-05_1":
  if "L_RA-COH-INC-05_1" is null then List<String>{} else { "L_RA-COH-INC-05_1".id + '|' + ToString(TB.ObsDate("L_RA-COH-INC-05_1")) }

/* RA-COH-INC-05 (inclusion): 最近一次 B 型肝炎表面抗原（HBsAg）陽性。 */
define "C_RA-COH-INC-05":
  "A_RA-COH-INC-05_1"

define "E_RA-COH-INC-05":
  Flatten({ "EA_RA-COH-INC-05_1" })

define function "TP_RA-COH-INC-06_1"(X FHIR.MedicationRequest):
  if (First(X.dosageInstruction).timing.repeat.bounds as FHIR.Period).start is not null or (First(X.dosageInstruction).timing.repeat.bounds as FHIR.Period).end is not null then (First(X.dosageInstruction).timing.repeat.bounds as FHIR.Period)
  else X.dispenseRequest.validityPeriod

define function "SD_RA-COH-INC-06_1"(X FHIR.MedicationRequest):
  if X.dispenseRequest.expectedSupplyDuration.value.value >= 0 then Truncate(X.dispenseRequest.expectedSupplyDuration.value.value * (case when Matches(Lower(Coalesce(X.dispenseRequest.expectedSupplyDuration.code.value, X.dispenseRequest.expectedSupplyDuration.unit.value)), '^ *(d|day|days) *$') then 1.0 when Matches(Lower(Coalesce(X.dispenseRequest.expectedSupplyDuration.code.value, X.dispenseRequest.expectedSupplyDuration.unit.value)), '^ *(wk|week|weeks) *$') then 7.0 else null end)) else null

define function "TS_RA-COH-INC-06_1"(X FHIR.MedicationRequest):
  Coalesce(date from "TP_RA-COH-INC-06_1"(X).start, date from X.authoredOn)

define function "TE_RA-COH-INC-06_1"(X FHIR.MedicationRequest):
  Coalesce(date from "TP_RA-COH-INC-06_1"(X).end, if "SD_RA-COH-INC-06_1"(X) is null then null else if "SD_RA-COH-INC-06_1"(X) <= 1 then "TS_RA-COH-INC-06_1"(X)
    else "TS_RA-COH-INC-06_1"(X) + System.Quantity { value: ToDecimal("SD_RA-COH-INC-06_1"(X) - 1), unit: 'day' })

define "Q_RA-COH-INC-06_1":
  [MedicationRequest: "VS_RA_BIOLOGIC"] X where (date from X.authoredOn in Interval[IndexDate - 365 days, IndexDate] or (date from X.authoredOn is not null and "TE_RA-COH-INC-06_1"(X) >= IndexDate - 365 days and "TS_RA-COH-INC-06_1"(X) <= IndexDate))

define "U_RA-COH-INC-06_1":
  [MedicationRequest: "VS_RA_BIOLOGIC"] X where (date from X.authoredOn is null or ("TE_RA-COH-INC-06_1"(X) is null and date from X.authoredOn < IndexDate - 365 days and "TS_RA-COH-INC-06_1"(X) <= IndexDate))

