# H-112: the bench host's settings for the second serving profile (deploy/docker-compose.serving-second.yml).
# Placeholders only. On the bench host, copy this to deploy/site/serving-second.env (deploy/site is not in the
# repository and never in a release), owned by root, mode 0600, and fill every value there. Real names (the image,
# the program, the candidates' folders and served names) are written only in that copy, never here.
#
# The switch is the first key: `second` turns the second serving profile on, `current` (or no file) leaves the box
# exactly as it is. It lives here, never in deploy/.env (every service reads deploy/.env as its env file).
# tools/serving_profile.py refuses `second` unless every other key is filled, the box is a TEST box
# (TB_ENV of deploy/.env), and the image is pinned by digest; check-image checks the local image has that digest.
SERVING_ENGINE=current

# the image by digest only, never a tag: <repository>@sha256:<digest>, the one whose licence the walk read; compose
# runs it by that digest and never pulls it (tools/serving_profile.py check-image checks the local image has it)
SERVING2_IMAGE=<repository>@sha256:<digest>
# the engine's server program inside that image (its server for the /v1 chat routes)
SERVING2_SERVER=<program>

# the judge: a folder under the models folder, the served name the gateway's registry expects (the same name the
# current engine serves it under), and the engine's options file under the models folder (sequence length, batch,
# memory share, structured output backend)
SERVING2_JUDGE_DIR=<candidate folder>
SERVING2_JUDGE_NAME=<served name>
SERVING2_JUDGE_CONFIG=<options file>
# the judge's chat template under the models folder: the same file the current engine renders (JUDGE_CHAT_TEMPLATE,
# else the GPU overlay's default); the switch refuses another
SERVING2_JUDGE_CHAT_TEMPLATE=<template file>

# the verifier, the same three
SERVING2_VERIFIER_DIR=<candidate folder>
SERVING2_VERIFIER_NAME=<served name>
SERVING2_VERIFIER_CONFIG=<options file>
# the verifier's chat template under the models folder, one that renders with thinking off (as the current engine
# is asked to render it)
SERVING2_VERIFIER_CHAT_TEMPLATE=<template file>
