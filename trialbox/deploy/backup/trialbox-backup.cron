# The backup schedule (WS-08.6, D-187; RUNBOOK §5). Install as root from the install folder:
#   sed "s#/opt/trialbox#$PWD#" deploy/backup/trialbox-backup.cron > /etc/cron.d/trialbox-backup
#   chmod 644 /etc/cron.d/trialbox-backup
# Times are the box's local time. Put the nightly run after the night's screening jobs (site survey question 72).
# MAILTO: the box administrator; cron mails what a failing run prints (no patient data in it).
SHELL=/bin/sh
MAILTO=root
# 04:45: the encrypted backup to every TB_BACKUP_TARGETS directory, then pgBackRest when WAL archiving is on
45 4 * * * root cd /opt/trialbox && { python3 -m tools.trialbox backup-nightly >> /var/log/trialbox-backup.log 2>&1 || echo "backup-nightly failed: /var/log/trialbox-backup.log, RUNBOOK 5"; }
# every hour: the age of the newest good off-box backup; prints (and alerts) only when something is wrong
17 * * * * root cd /opt/trialbox && python3 -m tools.trialbox backup-status --quiet
