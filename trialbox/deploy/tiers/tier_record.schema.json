{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trialbox.local/deploy/tiers/tier_record.schema.json",
  "title": "TierRecord",
  "description": "The tier record of one GPU profile (plan 10 row 10E-1, commitment C-4, decision record docs/decisions/D-TIERREC-the-tier-record-states-only-what-is-measured-or-declared.md): what the gateway, the scheduler, the console, the host check, doctor and the capability page read about the box. Every field carries its basis: measured (a measurement record of this profile on its own uncapped card, named by path), declared (a file and line that declares it) or not_measured (value null, and the run or card that would measure it). Format tb-tier-record/1. Checked by tools/tier_record.py, which adds what JSON Schema cannot say (sources exist, a measured source passes the serving record rule, no ballast stand-in).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "tier", "measured_on", "fields"],
  "properties": {
    "schema": {"const": "tb-tier-record/1"},
    "profile": {"type": "string", "description": "The GPU profile deploy/gpu_profile.sh prints for this box; the file is deploy/tiers/<profile>.json"},
    "tier": {"type": "string", "description": "The tier name tools/tiers.py gives this profile"},
    "measured_on": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serving_record", "qualification_record"],
      "properties": {
        "serving_record": {"type": ["string", "null"], "description": "Path of this profile's serving record taken on its own uncapped card, or null when none is on file"},
        "qualification_record": {"type": ["string", "null"], "description": "Path of this profile's qualification record, or null when none is on file"}
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "box_role",
        "card_names",
        "arch",
        "card_memory_mib",
        "driver",
        "ecc",
        "desk_side",
        "host_memory_gib_min",
        "judge_sequences",
        "verifier_sequences",
        "screen_concurrency",
        "context_tokens",
        "gpu_memory_utilization",
        "models_on_card",
        "note_rule",
        "judge_calls_per_second",
        "free_memory_at_peak_mib",
        "wake_seconds_p95",
        "startup_minutes",
        "idle_memory_mib",
        "power_limit_watts",
        "role_groups_on_box",
        "protocol_route",
        "interactive_lane",
        "busy_wait_seconds",
        "night_budget_patients",
        "first_load_nights",
        "console_promises"
      ],
      "properties": {
        "box_role": {"$ref": "#/$defs/value"},
        "card_names": {"$ref": "#/$defs/value"},
        "arch": {"$ref": "#/$defs/value"},
        "card_memory_mib": {"$ref": "#/$defs/value"},
        "driver": {"$ref": "#/$defs/value"},
        "ecc": {"$ref": "#/$defs/value"},
        "desk_side": {"$ref": "#/$defs/value"},
        "host_memory_gib_min": {"$ref": "#/$defs/value"},
        "judge_sequences": {"$ref": "#/$defs/value"},
        "verifier_sequences": {"$ref": "#/$defs/value"},
        "screen_concurrency": {"$ref": "#/$defs/value"},
        "context_tokens": {"$ref": "#/$defs/value"},
        "gpu_memory_utilization": {"$ref": "#/$defs/value"},
        "models_on_card": {"$ref": "#/$defs/value"},
        "note_rule": {"$ref": "#/$defs/value"},
        "judge_calls_per_second": {"$ref": "#/$defs/value"},
        "free_memory_at_peak_mib": {"$ref": "#/$defs/value"},
        "wake_seconds_p95": {"$ref": "#/$defs/value"},
        "startup_minutes": {"$ref": "#/$defs/value"},
        "idle_memory_mib": {"$ref": "#/$defs/value"},
        "power_limit_watts": {"$ref": "#/$defs/value"},
        "role_groups_on_box": {"$ref": "#/$defs/value"},
        "protocol_route": {"$ref": "#/$defs/value"},
        "interactive_lane": {"$ref": "#/$defs/value"},
        "busy_wait_seconds": {"$ref": "#/$defs/value"},
        "night_budget_patients": {"$ref": "#/$defs/value"},
        "first_load_nights": {"$ref": "#/$defs/value"},
        "console_promises": {"$ref": "#/$defs/value"}
      }
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "value", "source"],
          "properties": {
            "basis": {"enum": ["measured", "declared"]},
            "value": {"not": {"type": "null"}},
            "source": {"type": "string", "minLength": 1, "description": "measured: the record's path; declared: path[:line or lines] of the declaration, then free text"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "value", "measured_by"],
          "properties": {
            "basis": {"const": "not_measured"},
            "value": {"type": "null"},
            "measured_by": {"type": "string", "minLength": 1, "description": "The run or card that would measure it"}
          }
        }
      ]
    }
  }
}
