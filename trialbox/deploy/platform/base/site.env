TB_ENV=PRODUCTION
TB_TOPOLOGY=A
TB_SITE_ID=DEMO-A
TB_TZ=Asia/Taipei
TB_SETTINGS=/etc/trialbox/settings.yaml
TB_OBJECT_STORE=fs:/data/objects
TB_LAKE_SOURCE=legacy
TB_EMBED_MODE=hash
TB_CTGOV_MODE=offline
TB_NOTE_BLOCK=never
TB_MODEL_SWAP=off
TB_CONSOLE_SECURE_COOKIE=1
FHIR_BASE_URL=http://fhir-store:8080/fhir
LAKE_URL=http://lake:8013
EMBED_URL=http://embed-service:8014
TB_GATEWAY_URL=http://gateway:8020/v1
TB_SERVICE_TOKEN_FILE=/run/secrets/tb_service_token
TB_SERVICE_TOKENS=/etc/trialbox/service-tokens/tokens.json
SMTP_HOST=
SMTP_PORT=587
IMAP_HOST=
IMAP_PORT=993
NHI_TWPAS_BASE_URL=
CLOUD_LLM_BASE_URL=
LOG_LEVEL=INFO
