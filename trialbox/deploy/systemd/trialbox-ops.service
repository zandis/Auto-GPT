# The console's operations runner (D-178), the unit of RUNBOOK §15. deploy/install.sh installs it and turns its
# timer on (NEW-OPS-8, D-561): it writes the host's health facts and runs the Operations page's requests.
[Unit]
Description=TrialBox operations requests
After=trialbox.service

[Service]
Type=oneshot
WorkingDirectory=@TB_ROOT@
ExecStart=/usr/bin/env python3 -m tools.trialbox ops run
