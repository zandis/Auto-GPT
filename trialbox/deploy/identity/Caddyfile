# TrialBox edge (D-193): TLS on 443 in front of the console and, when the site uses it, Authelia.
# Started by deploy/docker-compose.identity.yml; every value comes from deploy/.env (deploy/identity/identity.env.example).
#
#   TB_TLS_MODE=internal   Caddy's own CA issues the certificate (the default). Install its root certificate on the
#                          staff PCs once (RUNBOOK §12). Nothing is fetched from the internet.
#   TB_TLS_MODE=hospital   the hospital's certificate: TB_TLS_CERT_FILE (chain, PEM) and TB_TLS_KEY_FILE (PEM),
#                          mounted read-only at /etc/caddy/certs. Check them first: python -m console.cli check-tls
#
#   TB_TLS_OLD_CLIENTS=off the TLS policy as it stands (D-1328): TLS 1.2 and 1.3, AEAD suites with ECDHE only (the
#                          default and the only setting the per-release TLS check passes).
#   TB_TLS_OLD_CLIENTS=cbc H-48 (D-1328, amended 2026-11-19): a hospital's old client without AEAD also gets the four
#                          TLS 1.2 ECDHE suites with AES-CBC-SHA. Never TLS 1.0/1.1, static RSA, 3DES, RC4, export or
#                          NULL. Off by default; deploy/install.sh audits the switch (update.tls_relaxed) and
#                          `trialbox doctor` shows a line while it is on (RUNBOOK §12, the TLS check per release).
#
# The certificate must name TB_TLS_HOSTNAME and, with OIDC, TB_AUTH_HOSTNAME (two names or a wildcard).
{
	admin off
	# the box has no route to a public ACME CA: never try one; certificates are internal or the hospital's
	local_certs
	skip_install_trust
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

# T-108a (D-360): the container's health check (docker-compose.identity.yml), plain HTTP on the loopback only;
# the port is never published
http://127.0.0.1:2020 {
	bind 127.0.0.1
	respond /healthz "ok" 200
	respond 404
}

# tls_<TB_TLS_MODE> takes suites_<TB_TLS_MODE>_<TB_TLS_OLD_CLIENTS>
(tls_internal) {
	import suites_internal_{$TB_TLS_OLD_CLIENTS:off}
}

(tls_hospital) {
	import suites_hospital_{$TB_TLS_OLD_CLIENTS:off}
}

# TB_TLS_OLD_CLIENTS=off: what Caddy served before H-48 (Caddy's own suites: AEAD with ECDHE)
(suites_internal_off) {
	tls internal
}

(suites_hospital_off) {
	tls /etc/caddy/certs/site.crt /etc/caddy/certs/site.key {
		protocols tls1.2 tls1.3
	}
}

# TB_TLS_OLD_CLIENTS=cbc: Caddy's AEAD suites as above plus the four ECDHE AES-CBC-SHA suites (TLS 1.2 only; TLS 1.3
# is unchanged). tools/tls_policy.py reports this as the named exception, never as a pass
(suites_internal_cbc) {
	tls internal {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA
	}
}

(suites_hospital_cbc) {
	tls /etc/caddy/certs/site.crt /etc/caddy/certs/site.key {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA
	}
}

(edge) {
	import tls_{$TB_TLS_MODE:internal}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	# no query strings in the log (an OIDC code, a state, search words), no cookies, no Authorization (review M4)
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.*$ ""
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}

{$TB_TLS_HOSTNAME}:443 {
	import edge
	request_body {
		max_size 60MB
	}
	# D-192 review H1: no identity header from a browser ever reaches the console. The console also refuses its
	# trusted-header SSO whenever TOTP or OIDC is on, and a header never signs in a local account.
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
	request_header -X-Remote-User
	request_header -X-Forwarded-User
	request_header -X-Forwarded-Groups
	request_header -X-Forwarded-Email
	request_header -X-Forwarded-Preferred-Username
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups
	request_header -X-Auth-Request-Preferred-Username
	request_header -{$TB_CONSOLE_SSO_HEADER:X-TB-No-Sso-Header}
	request_header -{$TB_CONSOLE_SSO_ROLE_HEADER:X-TB-No-Sso-Role}
	request_header -{$TB_CONSOLE_SSO_MAILBOX_HEADER:X-TB-No-Sso-Mailbox}
	reverse_proxy console:8090
}

{$TB_AUTH_HOSTNAME:auth.invalid}:443 {
	import edge
	reverse_proxy authelia:9091
}
