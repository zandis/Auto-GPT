# Hospital-IT settings for identity and TLS (D-192, D-193). Copy the lines you need into deploy/.env; compose reads
# them there (deploy/docker-compose.identity.yml) and so does `python -m console.cli check-tls`. RUNBOOK §12.
# Nothing here is a secret: secrets are files under deploy/secrets/ (0600). Comments stay on their own lines.

# --- TLS (Caddy on 443) -----------------------------------------------------------------------------------------
# The console's DNS name on the hospital network (required).
TB_TLS_HOSTNAME=trialbox.hospital.example
# internal: Caddy's own CA issues the certificate; hospital: the certificate and key files below.
TB_TLS_MODE=internal
# Hospital mode: the certificate with its chain (PEM) and its private key (PEM, unencrypted, 0600 root).
# TB_TLS_CERT_FILE=/etc/trialbox/tls/trialbox.crt
# TB_TLS_KEY_FILE=/etc/trialbox/tls/trialbox.key
# The address 443 listens on (with two network cards: the LAN address).
# TB_TLS_BIND=0.0.0.0

# --- Local accounts and sessions --------------------------------------------------------------------------------
# TOTP for local accounts; "off" is refused in PRODUCTION.
TB_CONSOLE_MFA=totp
# Idle lock in minutes (1-60), never longer than the hospital's policy; absolute session lifetime in hours (1-12).
TB_CONSOLE_IDLE_MINUTES=10
TB_CONSOLE_SESSION_HOURS=8
# Secure cookies are always on with deploy/docker-compose.identity.yml.

# --- Hospital account through Authelia (OIDC, off by default) ---------------------------------------------------
# 1 together with `--profile oidc`.
TB_OIDC_ENABLED=0
# Authelia's portal name (the certificate must name it too) and its issuer address.
# TB_AUTH_HOSTNAME=auth.trialbox.hospital.example
# TB_OIDC_ISSUER=https://auth.trialbox.hospital.example
# TB_OIDC_CLIENT_ID=trialbox-console
# The plain client secret, a file (Authelia's configuration holds only its digest).
# TB_OIDC_CLIENT_SECRET=./secrets/authelia/oidc_client_secret.txt
# TB_OIDC_LOGOUT_URL=https://auth.trialbox.hospital.example/logout
# The CA the console trusts for Authelia's back channel: Caddy's root (internal mode) or the hospital's chain.
# TB_OIDC_CA=./secrets/tls/caddy-root.crt
# Directory groups -> TrialBox roles (admin, coordinator, investigator, viewer, cro). Only these groups give a role;
# a person in none of them, or in groups of two different roles, is refused.
# TB_OIDC_GROUP_ROLES=TB-Coordinators:coordinator,TB-Investigators:investigator,TB-Monitors:cro,TB-Admins:admin
# Refuse a sign-in the provider did not report as two-factor (amr).
# TB_OIDC_REQUIRE_MFA=1
