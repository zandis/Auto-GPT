     "op": "<",
     "unit": "mL/min/{1.73_m2}"
    },
    "valueset": "VS_EGFR_COMPONENTS",
    "window": {
     "anchor": "index",
     "from_days": -30,
     "to_days": 0
    }
   },
   {
    "domain": "procedure",
    "quantifier": "any",
    "valueset": "VS_DIALYSIS",
    "window": {
     "anchor": "index",
     "from_days": -30,
     "to_days": 0
    }
   },
   {
    "domain": "condition",
    "quantifier": "any",
    "valueset": "VS_DIALYSIS_DEPENDENCE"
   }
  ],
  "op": "or"
 },
 "ruleset": "EMPULSE",
 "source_ref": "ClinicalTrials.gov eligibility: Exclusion #8",
 "text": "Impaired renal function, eGFR <20 mL/min/1.73 m² (latest during hospitalisation) or requiring dialysis.",
