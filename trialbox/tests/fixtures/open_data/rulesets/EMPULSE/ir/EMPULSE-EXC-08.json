{
 "action": "order creatinine",
 "class": "structured",
 "id": "EMPULSE-EXC-08",
 "kind": "exclusion",
 "label": "eGFR <20 or dialysis",
 "logic": {
  "args": [
   {
    "derived": "egfr",
    "domain": "observation",
    "quantifier": "latest",
    "value": {
