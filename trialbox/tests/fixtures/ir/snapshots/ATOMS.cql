  exists ("Q_ATOMS-EXC-22_1")

define "EA_ATOMS-EXC-22_1":
  "Q_ATOMS-EXC-22_1" X return X.id + '|' + ToString(date from (X.performed as FHIR.dateTime))

/* ATOMS-EXC-22 (exclusion): bariatric surgery ever */
define "C_ATOMS-EXC-22":
  "A_ATOMS-EXC-22_1"

define "E_ATOMS-EXC-22":
  Flatten({ "EA_ATOMS-EXC-22_1" })

define "Q_ATOMS-EXC-23_1":
  [Observation: "VS_IGRA"] X where TB.ObsDate(X) in Interval[@1900-01-01, IndexDate]

define "L_ATOMS-EXC-23_1":
  TB.LatestObs("Q_ATOMS-EXC-23_1")

define "A_ATOMS-EXC-23_1":
  if "L_ATOMS-EXC-23_1" is null then null else (TB.ObsCode("L_ATOMS-EXC-23_1") in { 'LA6576-8' })

define "EA_ATOMS-EXC-23_1":
  if "L_ATOMS-EXC-23_1" is null then List<String>{} else { "L_ATOMS-EXC-23_1".id + '|' + ToString(TB.ObsDate("L_ATOMS-EXC-23_1")) }

define "Q_ATOMS-EXC-23_2":
  [MedicationRequest: "VS_TB_PREVENTIVE_THERAPY"] X where date from X.authoredOn in Interval[IndexDate - 365 days, IndexDate]

define "A_ATOMS-EXC-23_2":
  exists ("Q_ATOMS-EXC-23_2")

define "EA_ATOMS-EXC-23_2":
  "Q_ATOMS-EXC-23_2" X return X.id + '|' + ToString(date from X.authoredOn)

/* ATOMS-EXC-23 (exclusion): IGRA positive and not on TB prophylaxis */
define "C_ATOMS-EXC-23":
  ("A_ATOMS-EXC-23_1" and (not "A_ATOMS-EXC-23_2"))

define "E_ATOMS-EXC-23":
  Flatten({ "EA_ATOMS-EXC-23_1", "EA_ATOMS-EXC-23_2" })

define "Q_ATOMS-EXC-24_1":
  [Condition: "VS_TYPE_1_DIABETES_MELLITUS"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[@1900-01-01, IndexDate]

define "A_ATOMS-EXC-24_1":
  exists ("Q_ATOMS-EXC-24_1")

define "EA_ATOMS-EXC-24_1":
  "Q_ATOMS-EXC-24_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate))

define "A_ATOMS-EXC-24_2":
  ((if Patient.gender is null then null else Patient.gender.value = 'male'))

define "EA_ATOMS-EXC-24_2":
  List<String>{}

define "Q_ATOMS-EXC-24_3":
  [Observation: "VS_HBA1C"] X where TB.ObsDate(X) in Interval[IndexDate - 180 days, IndexDate]

define "L_ATOMS-EXC-24_3":
  TB.LatestObs("Q_ATOMS-EXC-24_3")

define "A_ATOMS-EXC-24_3":
  if "L_ATOMS-EXC-24_3" is null then null else (TB.ObsValue("L_ATOMS-EXC-24_3") > 10)

define "EA_ATOMS-EXC-24_3":
  if "L_ATOMS-EXC-24_3" is null then List<String>{} else { "L_ATOMS-EXC-24_3".id + '|' + ToString(TB.ObsDate("L_ATOMS-EXC-24_3")) }

/* ATOMS-EXC-24 (exclusion): T1DM or (male and HbA1c > 10) */
define "C_ATOMS-EXC-24":
  ("A_ATOMS-EXC-24_1" or ("A_ATOMS-EXC-24_2" and "A_ATOMS-EXC-24_3"))

define "E_ATOMS-EXC-24":
  Flatten({ "EA_ATOMS-EXC-24_1", "EA_ATOMS-EXC-24_2", "EA_ATOMS-EXC-24_3" })

define "Q_ATOMS-EXC-25_1":
  [MedicationRequest: "VS_COLCHICINE"] X where date from X.authoredOn in Interval[IndexDate - 10 days, IndexDate + 10 days]

define "A_ATOMS-EXC-25_1":
  exists ("Q_ATOMS-EXC-25_1")

define "EA_ATOMS-EXC-25_1":
  "Q_ATOMS-EXC-25_1" X return X.id + '|' + ToString(date from X.authoredOn)

/* ATOMS-EXC-25 (exclusion): future window: appointment-independent, med in [-10,+10] */
define "C_ATOMS-EXC-25":
  "A_ATOMS-EXC-25_1"

define "E_ATOMS-EXC-25":
  Flatten({ "EA_ATOMS-EXC-25_1" })

