  if "L_ATOMS-INC-10_1" is null then null as Boolean else if ((case when ("L_ATOMS-INC-10_1".value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-INC-10_1"("L_ATOMS-INC-10_1".value as FHIR.Quantity, "L_ATOMS-INC-10_1".code.coding) < 5 then false else null) when ("L_ATOMS-INC-10_1".value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-INC-10_1"("L_ATOMS-INC-10_1".value as FHIR.Quantity, "L_ATOMS-INC-10_1".code.coding) > 9 then false else null) else ("N_ATOMS-INC-10_1"("L_ATOMS-INC-10_1".value as FHIR.Quantity, "L_ATOMS-INC-10_1".code.coding) >= 5 and "N_ATOMS-INC-10_1"("L_ATOMS-INC-10_1".value as FHIR.Quantity, "L_ATOMS-INC-10_1".code.coding) <= 9) end)) is true and not exists ("U_ATOMS-INC-10_1" X where ((case when (X.value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-INC-10_1"(X.value as FHIR.Quantity, X.code.coding) < 5 then false else null) when (X.value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-INC-10_1"(X.value as FHIR.Quantity, X.code.coding) > 9 then false else null) else ("N_ATOMS-INC-10_1"(X.value as FHIR.Quantity, X.code.coding) >= 5 and "N_ATOMS-INC-10_1"(X.value as FHIR.Quantity, X.code.coding) <= 9) end)) is not true) then true else if ((case when ("L_ATOMS-INC-10_1".value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-INC-10_1"("L_ATOMS-INC-10_1".value as FHIR.Quantity, "L_ATOMS-INC-10_1".code.coding) < 5 then false else null) when ("L_ATOMS-INC-10_1".value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-INC-10_1"("L_ATOMS-INC-10_1".value as FHIR.Quantity, "L_ATOMS-INC-10_1".code.coding) > 9 then false else null) else ("N_ATOMS-INC-10_1"("L_ATOMS-INC-10_1".value as FHIR.Quantity, "L_ATOMS-INC-10_1".code.coding) >= 5 and "N_ATOMS-INC-10_1"("L_ATOMS-INC-10_1".value as FHIR.Quantity, "L_ATOMS-INC-10_1".code.coding) <= 9) end)) is false and not exists ("U_ATOMS-INC-10_1" X where ((case when (X.value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-INC-10_1"(X.value as FHIR.Quantity, X.code.coding) < 5 then false else null) when (X.value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-INC-10_1"(X.value as FHIR.Quantity, X.code.coding) > 9 then false else null) else ("N_ATOMS-INC-10_1"(X.value as FHIR.Quantity, X.code.coding) >= 5 and "N_ATOMS-INC-10_1"(X.value as FHIR.Quantity, X.code.coding) <= 9) end)) is not false) then false else null as Boolean

