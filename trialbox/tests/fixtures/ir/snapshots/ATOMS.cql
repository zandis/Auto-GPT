define function "N_ATOMS-INC-13_1"(Q FHIR.Quantity, Cd List<FHIR.Coding>):
  case
    when TB.UnitKey(Q) in { '', '#', '1', 'count', 'joints', 'score' } then Q.value.value
    else null end

define "Q_ATOMS-INC-13_1":
  [Observation] X where TB.ObsDate(X) in Interval[IndexDate - 365 days, IndexDate] and exists (X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE")

define "U_ATOMS-INC-13_1":
  [Observation] X where (X.effective is null or (X.effective is FHIR.Period and (X.effective as FHIR.Period).start is null)) and exists (X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE")

define "A_ATOMS-INC-13_1":
  if not exists ("Q_ATOMS-INC-13_1") then null else if exists ("Q_ATOMS-INC-13_1" X where (case when (First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) < 150 then false else null) when (First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) >= 150 then true else null) else ("N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) >= 150) end)) then true else if exists ("Q_ATOMS-INC-13_1" X where ((case when (First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) < 150 then false else null) when (First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) >= 150 then true else null) else ("N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) >= 150) end)) is null) then null else if exists ("U_ATOMS-INC-13_1" X where ((case when (First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) < 150 then false else null) when (First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) >= 150 then true else null) else ("N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) >= 150) end)) is not false) then null else false

define "EA_ATOMS-INC-13_1":
  "Q_ATOMS-INC-13_1" X where (case when (First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) < 150 then false else null) when (First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) >= 150 then true else null) else ("N_ATOMS-INC-13_1"(First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").value as FHIR.Quantity, First(X.component C where C.code in "VS_SYSTOLIC_BLOOD_PRESSURE").code.coding) >= 150) end) return X.id + '|' + ToString(TB.ObsDate(X))

