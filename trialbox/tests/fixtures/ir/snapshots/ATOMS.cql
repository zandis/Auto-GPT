define "Q_ATOMS-INC-17_1":
  [MedicationRequest: "VS_METHOTREXATE"] X

define "P_ATOMS-INC-17_1":
  "Q_ATOMS-INC-17_1" X
    let s: Max({ Coalesce(date from start of FHIRHelpers.ToInterval(X.dispenseRequest.validityPeriod), date from X.authoredOn), IndexDate - 730 days }),
        e: Min({ Coalesce(date from end of FHIRHelpers.ToInterval(X.dispenseRequest.validityPeriod), date from start of FHIRHelpers.ToInterval(X.dispenseRequest.validityPeriod), date from X.authoredOn), IndexDate })
    where Coalesce(date from start of FHIRHelpers.ToInterval(X.dispenseRequest.validityPeriod), date from X.authoredOn) is not null and s <= e
    return Interval[s, e]

define "D_ATOMS-INC-17_1":
  Coalesce(Max((collapse ("P_ATOMS-INC-17_1" I return Interval[start of I, end of I + 0 days]) per day) J
    return (days between start of J and (end of J - 0 days)) + 1), 0)

define "A_ATOMS-INC-17_1":
  "D_ATOMS-INC-17_1" >= 180

