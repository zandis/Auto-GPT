define "EA_ATOMS-INC-20_1":
  "Q_ATOMS-INC-20_1" X return X.id + '|' + ToString(date from X.created)

/* ATOMS-INC-20 (inclusion): biologic application in 365 d */
define "C_ATOMS-INC-20":
  "A_ATOMS-INC-20_1"

define "E_ATOMS-INC-20":
  Flatten({ "EA_ATOMS-INC-20_1" })

define "Q_ATOMS-INC-21_1":
  [Encounter] X where X.serviceType in "VS_RHEUMATOLOGY_CLINIC_VISIT" and date from X.period.start in Interval[IndexDate - 365 days, IndexDate]

define "U_ATOMS-INC-21_1":
  [Encounter] X where X.serviceType in "VS_RHEUMATOLOGY_CLINIC_VISIT" and date from X.period.start is null

define "A_ATOMS-INC-21_1":
  if Count("Q_ATOMS-INC-21_1") >= 3 then true else if Count("Q_ATOMS-INC-21_1") + Count("U_ATOMS-INC-21_1") >= 3 then null as Boolean else false

define "EA_ATOMS-INC-21_1":
  "Q_ATOMS-INC-21_1" X return X.id + '|' + ToString(date from X.period.start)

/* ATOMS-INC-21 (inclusion): >=3 RHEU visits in 1y */
define "C_ATOMS-INC-21":
  "A_ATOMS-INC-21_1"

define "E_ATOMS-INC-21":
  Flatten({ "EA_ATOMS-INC-21_1" })

define "Q_ATOMS-EXC-22_1":
  [Procedure: "VS_BARIATRIC_SURGERY"] X where date from (X.performed as FHIR.dateTime) in Interval[@1900-01-01, IndexDate]

define "U_ATOMS-EXC-22_1":
  [Procedure: "VS_BARIATRIC_SURGERY"] X where date from (X.performed as FHIR.dateTime) is null

define "A_ATOMS-EXC-22_1":
  if exists ("Q_ATOMS-EXC-22_1") then true else if exists ("U_ATOMS-EXC-22_1") then null as Boolean else false

define "EA_ATOMS-EXC-22_1":
  "Q_ATOMS-EXC-22_1" X return X.id + '|' + ToString(date from (X.performed as FHIR.dateTime))

/* ATOMS-EXC-22 (exclusion): bariatric surgery ever */
define "C_ATOMS-EXC-22":
  "A_ATOMS-EXC-22_1"

define "E_ATOMS-EXC-22":
  Flatten({ "EA_ATOMS-EXC-22_1" })

define "Q_ATOMS-EXC-23_1":
  [Observation: "VS_IGRA"] X where TB.ObsDate(X) in Interval[@1900-01-01, IndexDate]

define "U_ATOMS-EXC-23_1":
  [Observation: "VS_IGRA"] X where (X.effective is null or (X.effective is FHIR.Period and (X.effective as FHIR.Period).start is null))

define "L_ATOMS-EXC-23_1":
  TB.LatestObs("Q_ATOMS-EXC-23_1")

define "A_ATOMS-EXC-23_1":
  if "L_ATOMS-EXC-23_1" is null then null as Boolean else if ((TB.ObsCode("L_ATOMS-EXC-23_1") in { 'LA6576-8' })) is true and not exists ("U_ATOMS-EXC-23_1" X where ((TB.ObsCode(X) in { 'LA6576-8' })) is not true) then true else if ((TB.ObsCode("L_ATOMS-EXC-23_1") in { 'LA6576-8' })) is false and not exists ("U_ATOMS-EXC-23_1" X where ((TB.ObsCode(X) in { 'LA6576-8' })) is not false) then false else null as Boolean

define "EA_ATOMS-EXC-23_1":
  if "L_ATOMS-EXC-23_1" is null then List<String>{} else { "L_ATOMS-EXC-23_1".id + '|' + ToString(TB.ObsDate("L_ATOMS-EXC-23_1")) }

define "Q_ATOMS-EXC-23_2":
  [MedicationRequest: "VS_TB_PREVENTIVE_THERAPY"] X where date from X.authoredOn in Interval[IndexDate - 365 days, IndexDate]

define "U_ATOMS-EXC-23_2":
  [MedicationRequest: "VS_TB_PREVENTIVE_THERAPY"] X where date from X.authoredOn is null

define "A_ATOMS-EXC-23_2":
  if exists ("Q_ATOMS-EXC-23_2") then true else if exists ("U_ATOMS-EXC-23_2") then null as Boolean else false

define "EA_ATOMS-EXC-23_2":
  "Q_ATOMS-EXC-23_2" X return X.id + '|' + ToString(date from X.authoredOn)

/* ATOMS-EXC-23 (exclusion): IGRA positive and not on TB prophylaxis */
define "C_ATOMS-EXC-23":
  ("A_ATOMS-EXC-23_1" and (not "A_ATOMS-EXC-23_2"))

define "E_ATOMS-EXC-23":
  Flatten({ "EA_ATOMS-EXC-23_1", "EA_ATOMS-EXC-23_2" })

define "Q_ATOMS-EXC-24_1":
  [Condition: "VS_TYPE_1_DIABETES_MELLITUS"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) in Interval[@1900-01-01, IndexDate]

define "U_ATOMS-EXC-24_1":
  [Condition: "VS_TYPE_1_DIABETES_MELLITUS"] X where date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate) is null

define "A_ATOMS-EXC-24_1":
  if exists ("Q_ATOMS-EXC-24_1") then true else if exists ("U_ATOMS-EXC-24_1") then null as Boolean else false

define "EA_ATOMS-EXC-24_1":
  "Q_ATOMS-EXC-24_1" X return X.id + '|' + ToString(date from Coalesce(X.onset as FHIR.dateTime, X.recordedDate))

define "A_ATOMS-EXC-24_2":
  ((if Patient.gender.value in { 'male', 'female' } then Patient.gender.value = 'male' else null))

define "EA_ATOMS-EXC-24_2":
  List<String>{}

define function "N_ATOMS-EXC-24_3"(Q FHIR.Quantity, Cd List<FHIR.Coding>):
  case
    when TB.UnitKey(Q) in { '', '#', '1', 'count', 'joints', 'score' } then Q.value.value
    else null end

define "Q_ATOMS-EXC-24_3":
  [Observation: "VS_HBA1C"] X where TB.ObsDate(X) in Interval[IndexDate - 180 days, IndexDate]

define "U_ATOMS-EXC-24_3":
  [Observation: "VS_HBA1C"] X where (X.effective is null or (X.effective is FHIR.Period and (X.effective as FHIR.Period).start is null))

define "L_ATOMS-EXC-24_3":
  TB.LatestObs("Q_ATOMS-EXC-24_3")

define "A_ATOMS-EXC-24_3":
  if "L_ATOMS-EXC-24_3" is null then null as Boolean else if ((case when ("L_ATOMS-EXC-24_3".value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-EXC-24_3"("L_ATOMS-EXC-24_3".value as FHIR.Quantity, "L_ATOMS-EXC-24_3".code.coding) <= 10 then false else null) when ("L_ATOMS-EXC-24_3".value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-EXC-24_3"("L_ATOMS-EXC-24_3".value as FHIR.Quantity, "L_ATOMS-EXC-24_3".code.coding) > 10 then true else null) else ("N_ATOMS-EXC-24_3"("L_ATOMS-EXC-24_3".value as FHIR.Quantity, "L_ATOMS-EXC-24_3".code.coding) > 10) end)) is true and not exists ("U_ATOMS-EXC-24_3" X where ((case when (X.value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-EXC-24_3"(X.value as FHIR.Quantity, X.code.coding) <= 10 then false else null) when (X.value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-EXC-24_3"(X.value as FHIR.Quantity, X.code.coding) > 10 then true else null) else ("N_ATOMS-EXC-24_3"(X.value as FHIR.Quantity, X.code.coding) > 10) end)) is not true) then true else if ((case when ("L_ATOMS-EXC-24_3".value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-EXC-24_3"("L_ATOMS-EXC-24_3".value as FHIR.Quantity, "L_ATOMS-EXC-24_3".code.coding) <= 10 then false else null) when ("L_ATOMS-EXC-24_3".value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-EXC-24_3"("L_ATOMS-EXC-24_3".value as FHIR.Quantity, "L_ATOMS-EXC-24_3".code.coding) > 10 then true else null) else ("N_ATOMS-EXC-24_3"("L_ATOMS-EXC-24_3".value as FHIR.Quantity, "L_ATOMS-EXC-24_3".code.coding) > 10) end)) is false and not exists ("U_ATOMS-EXC-24_3" X where ((case when (X.value as FHIR.Quantity).comparator.value in { '<', '<=' } then (if "N_ATOMS-EXC-24_3"(X.value as FHIR.Quantity, X.code.coding) <= 10 then false else null) when (X.value as FHIR.Quantity).comparator.value in { '>', '>=' } then (if "N_ATOMS-EXC-24_3"(X.value as FHIR.Quantity, X.code.coding) > 10 then true else null) else ("N_ATOMS-EXC-24_3"(X.value as FHIR.Quantity, X.code.coding) > 10) end)) is not false) then false else null as Boolean

define "EA_ATOMS-EXC-24_3":
  if "L_ATOMS-EXC-24_3" is null then List<String>{} else { "L_ATOMS-EXC-24_3".id + '|' + ToString(TB.ObsDate("L_ATOMS-EXC-24_3")) }

/* ATOMS-EXC-24 (exclusion): T1DM or (male and HbA1c > 10) */
define "C_ATOMS-EXC-24":
  ("A_ATOMS-EXC-24_1" or ("A_ATOMS-EXC-24_2" and "A_ATOMS-EXC-24_3"))

define "E_ATOMS-EXC-24":
  Flatten({ "EA_ATOMS-EXC-24_1", "EA_ATOMS-EXC-24_2", "EA_ATOMS-EXC-24_3" })

define "Q_ATOMS-EXC-25_1":
  [MedicationRequest: "VS_COLCHICINE"] X where date from X.authoredOn in Interval[IndexDate - 10 days, IndexDate + 10 days]

define "U_ATOMS-EXC-25_1":
  [MedicationRequest: "VS_COLCHICINE"] X where date from X.authoredOn is null

define "A_ATOMS-EXC-25_1":
  if exists ("Q_ATOMS-EXC-25_1") then true else if exists ("U_ATOMS-EXC-25_1") then null as Boolean else false

define "EA_ATOMS-EXC-25_1":
  "Q_ATOMS-EXC-25_1" X return X.id + '|' + ToString(date from X.authoredOn)

/* ATOMS-EXC-25 (exclusion): future window: appointment-independent, med in [-10,+10] */
define "C_ATOMS-EXC-25":
  "A_ATOMS-EXC-25_1"

define "E_ATOMS-EXC-25":
  Flatten({ "EA_ATOMS-EXC-25_1" })

