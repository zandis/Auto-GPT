# TrialBox runs on Linux (bash scripts, Makefile, Dockerfiles): keep LF line endings on every OS, also on Windows
* text=auto eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.docx binary
*.ttf binary
*.jar binary
*.sqlite binary
*.gz binary
*.zip binary
*.csv -text
*.tsv -text
*.eml -text

# Data file types (D-203, TB-SITE-03 §2, WS-13.10): `tb-data` marks a file the data-handling scan refuses
# (tools/data_scan.py: `make data-scan`, the pre-commit hook, CI). Allowed only under the fixture, eval, catalogue
# and refdata folders and as the reference tables named below (code lists and synthetic test patients, never a
# site's data). A new exception is a reviewed line here, with its reason.
*.csv tb-data
*.tsv tb-data
*.xlsx tb-data
*.xls tb-data
*.ndjson tb-data
*.json.gz tb-data
*.ndjson.gz tb-data
*.hl7 tb-data
*.duckdb tb-data
*.parquet tb-data
tests/fixtures/** -tb-data
eval/** -tb-data
catalogue/** -tb-data
refdata/** -tb-data
# the traceability matrix (generated by tools/gen_traceability.py)
docs/plan/25-traceability.csv -tb-data
# the archived commitments register (T-641, removed from CI by D-311): promise sentences, no patient
docs/plan/sites/archive/commitments.csv -tb-data
# each ruleset's synthetic FHIR test patients
rulesets/*/tests/patients.ndjson -tb-data
# code maps and terminology tables (public code systems, no patient)
services/adapter/mapping/** -tb-data
services/criteria_compiler/terminology/** -tb-data
services/datacore/builtin/forms.csv -tb-data
services/sitesetup/dx_names.csv -tb-data
# the hand-curated zh-TW clinical synonyms of the name matcher (D-172): terms and their English canonical names, no patient
libs/tb_common/refdata_src/*.csv -tb-data
