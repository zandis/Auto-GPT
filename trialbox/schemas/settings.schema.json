{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trialbox.local/schemas/v1/settings.schema.json",
  "title": "Settings",
  "description": "settings.yaml (SPEC 10.4). tb_common.config.load() validates it and refuses to start on error. Schema version 1.1.0 (1.1.0: practitioner licence and national id for TWPAS).",
  "type": "object",
  "required": [
    "site",
    "internal_domains",
    "allowlist",
    "permissions",
    "reviewers",
    "data_source",
    "thresholds",
    "schedule"
  ],
  "additionalProperties": false,
  "properties": {
    "site": {
      "title": "SiteInfo",
      "type": "object",
      "required": [
        "id",
        "name",
        "tz"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "name": {
          "type": "string"
        },
        "tz": {
          "type": "string"
        },
        "locale": {
          "type": "string",
          "default": "zh-TW"
        },
        "contact": {
          "type": "string"
        }
      }
    },
    "internal_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowlist": {
      "title": "Allowlist",
      "type": "object",
      "required": [
        "senders"
      ],
      "additionalProperties": false,
      "properties": {
        "senders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "physicians": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alliance_sites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "sender addresses of alliance member boxes (COHORT MERGE)"
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "command -> list of groups (senders|reviewers|physicians|alliance_sites) or explicit addresses",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "require_spf_dkim": {
      "type": "boolean",
      "default": true
    },
    "rate_limit_per_sender_per_day": {
      "description": "Jobs of each heavy type (FEAS, SCREEN, COHORT, NAV, MICROBATCH, CALIBRATION) one sender may start in 24 hours (D-146)",
      "type": "integer",
      "default": 20
    },
    "rate_limits_per_day": {
      "description": "Per job type daily limit per sender, overriding rate_limit_per_sender_per_day; 0 = no limit (D-146)",
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "data_source": {
      "title": "DataSource",
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "cgrd_sql",
            "csv",
            "fhir_bulk",
            "ssmix2"
          ]
        },
        "dsn_env": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "mapping": {
          "type": "string"
        },
        "nightly_at": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "lab_local_to_loinc": {
          "type": "string"
        },
        "encoding": {
          "description": "The character set the site declares for its csv export (T-615b): tried first by the one detector; UTF-8 is always read",
          "enum": [
            "utf-8",
            "big5",
            "cp950",
            "shift_jis",
            "cp932"
          ]
        }
      }
    },
    "feed_completeness": {
      "title": "FeedCompleteness",
      "description": "The completeness gate of the nightly ingest (T-611): a night that fails it is held, never published",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_table_drop_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 10,
          "description": "a full night whose source table has this share fewer rows than the last good night is held"
        },
        "required_tables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "mapping tables that must be present with rows on every night, the first one too"
        },
        "optional_tables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "mapping tables that may be absent or empty on a night although the last good night had rows"
        }
      }
    },
    "mrn_regex": {
      "type": "string",
      "default": "^\\d{8}$"
    },
    "profiles": {
      "title": "Profiles",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tw_core": {
          "type": "string",
          "default": "1.0.0"
        },
        "twpas_version": {
          "type": "string",
          "default": "1.2.5"
        }
      }
    },
    "models": {
      "title": "SiteModels",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judge": {
          "type": "string"
        },
        "extract_local": {
          "type": "string"
        },
        "embed": {
          "type": "string"
        },
        "cloud_enabled": {
          "type": "boolean",
          "default": false
        },
        "cloud_model": {
          "type": "string"
        }
      }
    },
    "thresholds": {
      "title": "SiteThresholds",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier_high_confidence": {
          "type": "number",
          "default": 0.75
        },
        "small_cell": {
          "type": "integer",
          "default": 5
        },
        "equivalence_min_pct": {
          "type": "number",
          "default": 98
        },
        "validation_error_max_pct": {
          "type": "number",
          "default": 0.5
        }
      }
    },
    "schedule": {
      "title": "Schedule",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "nightly",
            "on_demand"
          ],
          "default": "auto",
          "description": "auto: on_demand with TB_ENV DEV, nightly otherwise (FR-OPS-12). on_demand: no timed runs; jobs run when requested."
        },
        "ingest": {
          "type": "string",
          "default": "02:00"
        },
        "microbatch": {
          "type": "string",
          "default": "MON 03:00"
        },
        "nav": {
          "type": "string",
          "default": "MON 03:30"
        },
        "cohort": {
          "type": "string",
          "default": "1st 04:00"
        },
        "retention": {
          "type": "string",
          "default": "05:00"
        },
        "calibration": {
          "type": "string",
          "default": "1st 05:30"
        }
      }
    },
    "site_capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "registry_source": {
      "title": "RegistrySource",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "sql",
            "csv",
            "none"
          ]
        },
        "dsn_env": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "attachment_encryption": {
      "enum": [
        "zip",
        "smime",
        "link"
      ],
      "default": "link",
      "description": "Patient files by mail, chosen per site: link (the default, D-369: no attachment; a link to the job on the box, where the named recipients download after sign-in; needs TB_CONSOLE_URL), smime, or zip (7z + password in a second mail, PPAP; refused for patient files outside TB_ENV DEV and TEST, D-369). D-127."
    },
    "smime_certs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "recipient address -> PEM certificate path"
    },
    "departments": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "NHI department code -> display name"
    },
    "practitioners": {
      "type": "object",
      "additionalProperties": {
        "title": "PractitionerInfo",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "capacity_per_month": {
            "type": "number"
          },
          "license": {
            "type": "string",
            "description": "medical licence number (醫師證書字號), TWPAS Practitioner identifier"
          },
          "national_id": {
            "type": "string",
            "description": "national id; only used inside TWPAS bundles (phi)"
          }
        }
      }
    },
    "retention": {
      "title": "Retention",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attachments_days": {
          "type": "integer",
          "default": 90
        },
        "outputs_days": {
          "type": "integer",
          "default": 365
        },
        "logs_days": {
          "type": "integer",
          "default": 365,
          "description": "service (container) logs collected on the host, then deleted (D-138)"
        },
        "mail_log_days": {
          "type": "integer",
          "default": 1825,
          "description": "mail intake and sent log, the morning-mail log (D-138); the audit chain keeps every mail event"
        },
        "nightly_snapshots": {
          "type": "integer",
          "default": 3
        },
        "month_end_snapshots_months": {
          "type": "integer",
          "default": 36
        },
        "pool_months_after_ruleset": {
          "type": "integer",
          "default": 24
        },
        "audit_years": {
          "type": "integer",
          "default": 10,
          "description": "the audit chain is never deleted; it is copied to the archive every night (D-138)"
        }
      }
    },
    "calibration_defaults": {
      "title": "CalibrationDefaults",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reach_rate": {
          "type": "number",
          "default": 0.6
        },
        "accept_rate": {
          "type": "number",
          "default": 0.35
        }
      }
    },
    "twpas": {
      "title": "TwpasSettings",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "org_id": {
          "type": "string",
          "description": "NHI hospital code (must exist in the TWPAS organization-identifier code system)"
        },
        "org_name": {
          "type": "string"
        }
      }
    },
    "ethics_gate": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null,
      "description": "Study ethics gate (FR-STUDY-06, 20-build-map F6-03): always off with TB_ENV DEV or TEST; elsewhere this value, on when unset."
    },
    "cohort": {
      "title": "CohortSettings",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alliance_root": {
          "type": "boolean",
          "default": false
        },
        "root_address": {
          "type": "string"
        },
        "rulesets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ctgov_cache_days": {
          "type": "integer",
          "default": 30
        }
      }
    }
  }
}
