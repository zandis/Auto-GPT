{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trialbox.local/schemas/v1/settings.schema.json",
  "title": "Settings",
  "description": "settings.yaml (SPEC 10.4). tb_common.config.load() validates it and refuses to start on error. Schema version 1.0.0.",
  "type": "object",
  "required": ["site", "internal_domains", "allowlist", "permissions", "reviewers", "data_source", "thresholds", "schedule"],
  "additionalProperties": false,
  "properties": {
    "site": {
      "title": "SiteInfo",
      "type": "object",
      "required": ["id", "name", "tz"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
        "name": {"type": "string"},
        "tz": {"type": "string"},
        "locale": {"type": "string", "default": "zh-TW"},
        "contact": {"type": "string"}
      }
    },
    "internal_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowlist": {
      "title": "Allowlist",
      "type": "object",
      "required": ["senders"],
      "additionalProperties": false,
      "properties": {
        "senders": {"type": "array", "items": {"type": "string"}},
        "physicians": {"type": "array", "items": {"type": "string"}},
        "alliance_sites": {"type": "array", "items": {"type": "string"}, "description": "sender addresses of alliance member boxes (COHORT MERGE)"}
      }
    },
    "permissions": {
      "type": "object",
      "description": "command -> list of groups (senders|reviewers|physicians|alliance_sites) or explicit addresses",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "reviewers": {"type": "array", "items": {"type": "string"}},
    "require_spf_dkim": {"type": "boolean", "default": true},
    "rate_limit_per_sender_per_day": {"type": "integer", "default": 20},
    "data_source": {
      "title": "DataSource",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["cgrd_sql", "csv", "fhir_bulk", "ssmix2"]},
        "dsn_env": {"type": "string"},
        "path": {"type": "string"},
        "mapping": {"type": "string"},
        "nightly_at": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "lab_local_to_loinc": {"type": "string"}
      }
    },
    "mrn_regex": {"type": "string", "default": "^\\d{8}$"},
    "profiles": {
      "title": "Profiles",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tw_core": {"type": "string", "default": "1.0.0"},
        "twpas_version": {"type": "string", "default": "1.2.5"}
      }
    },
    "models": {
      "title": "SiteModels",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judge": {"type": "string"},
        "extract_local": {"type": "string"},
        "embed": {"type": "string"},
        "cloud_enabled": {"type": "boolean", "default": false},
        "cloud_model": {"type": "string"}
      }
    },
    "thresholds": {
      "title": "SiteThresholds",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier_high_confidence": {"type": "number", "default": 0.75},
        "small_cell": {"type": "integer", "default": 5},
        "equivalence_min_pct": {"type": "number", "default": 98},
        "validation_error_max_pct": {"type": "number", "default": 0.5}
      }
    },
    "schedule": {
      "title": "Schedule",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingest": {"type": "string", "default": "02:00"},
        "microbatch": {"type": "string", "default": "MON 03:00"},
        "nav": {"type": "string", "default": "MON 03:30"},
        "cohort": {"type": "string", "default": "1st 04:00"},
        "retention": {"type": "string", "default": "05:00"},
        "calibration": {"type": "string", "default": "1st 05:30"}
      }
    },
    "site_capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "registry_source": {
      "title": "RegistrySource",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["sql", "csv", "none"]},
        "dsn_env": {"type": "string"},
        "path": {"type": "string"}
      }
    },
    "attachment_encryption": {"enum": ["zip", "smime"], "default": "zip"},
    "smime_certs": {"type": "object", "additionalProperties": {"type": "string"}, "description": "recipient address -> PEM certificate path"},
    "departments": {"type": "object", "additionalProperties": {"type": "string"}, "description": "NHI department code -> display name"},
    "practitioners": {
      "type": "object",
      "additionalProperties": {
        "title": "PractitionerInfo",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "department": {"type": "string"},
          "email": {"type": "string"},
          "capacity_per_month": {"type": "number"}
        }
      }
    },
    "retention": {
      "title": "Retention",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attachments_days": {"type": "integer", "default": 90},
        "outputs_days": {"type": "integer", "default": 365},
        "logs_days": {"type": "integer", "default": 180},
        "nightly_snapshots": {"type": "integer", "default": 3},
        "month_end_snapshots_months": {"type": "integer", "default": 36},
        "pool_months_after_ruleset": {"type": "integer", "default": 24},
        "audit_years": {"type": "integer", "default": 10}
      }
    },
    "calibration_defaults": {
      "title": "CalibrationDefaults",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reach_rate": {"type": "number", "default": 0.6},
        "accept_rate": {"type": "number", "default": 0.35}
      }
    },
    "twpas": {
      "title": "TwpasSettings",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "dry_run": {"type": "boolean", "default": true},
        "org_id": {"type": "string", "description": "NHI hospital code"},
        "org_name": {"type": "string"}
      }
    },
    "cohort": {
      "title": "CohortSettings",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alliance_root": {"type": "boolean", "default": false},
        "root_address": {"type": "string"},
        "rulesets": {"type": "array", "items": {"type": "string"}},
        "ctgov_cache_days": {"type": "integer", "default": 30}
      }
    }
  }
}
