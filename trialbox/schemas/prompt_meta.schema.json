{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trialbox.local/schemas/v1/prompt_meta.schema.json",
  "title": "PromptMeta",
  "description": "YAML front matter of services/*/prompts/<id>_v<n>.md (SPEC 7). Schema version 1.0.0.",
  "type": "object",
  "required": [
    "id",
    "version",
    "model_class",
    "output_schema"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "model_class": {
      "enum": [
        "cloud",
        "local"
      ]
    },
    "output_schema": {
      "type": "string"
    },
    "max_tokens": {
      "type": "integer",
      "default": 2048
    },
    "temperature": {
      "type": "number",
      "default": 0
    },
    "phi": {
      "type": "boolean",
      "default": false
    }
  }
}
