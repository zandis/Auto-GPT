{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trialbox.local/schemas/v1/ruleset_manifest.schema.json",
  "title": "RulesetManifest",
  "description": "rulesets/<ID>/manifest.yaml (SPEC 3.4). Schema version 1.0.0.",
  "type": "object",
  "required": ["id", "kind", "title", "version", "index_date_rule", "scopes", "routing", "thresholds", "criteria"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,16}$"},
    "kind": {"enum": ["trial", "nhi", "cohort"]},
    "title": {"type": "string"},
    "trial_alias": {"type": "string"},
    "sponsor": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "approved"], "default": "draft"},
    "source_documents": {"type": "array", "items": {"type": "string"}},
    "protocol_version": {"type": "string"},
    "protocol_date": {"type": "string", "format": "date", "description": "the date of the protocol version these criteria come from (D-364)"},
    "effective_from": {"type": "string", "format": "date", "description": "the first site day this criteria version screens (D-364, LIFE-009): until then the box keeps screening on the version before it"},
    "irb_reference": {"type": "string", "maxLength": 64, "description": "the IRB approval number of this protocol version as the approver typed it (D-364): a record printed with the approval, not a gate (D-311)"},
    "irb_approved_on": {"type": "string", "format": "date", "description": "the day the IRB approved this protocol version (D-364), a record"},
    "language": {"type": "string"},
    "index_date_rule": {"enum": ["run_date", "month_end"]},
    "library": {"type": "string", "description": "CQL library name TB_<RULESET>_v<major>_<minor>"},
    "criteria": {"type": "array", "items": {"type": "string"}, "description": "criterion ids in funnel/report order"},
    "scopes": {"$ref": "#/$defs/scopes"},
    "routing": {"$ref": "#/$defs/routing"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "models": {"$ref": "#/$defs/models"},
    "review": {"$ref": "#/$defs/manifest_review"},
    "equivalence": {"$ref": "#/$defs/equivalence_summary"},
    "variants": {"type": "object", "additionalProperties": {"type": "string"}, "description": "named default sensitivity variants, e.g. bmi: '24,25,27'"},
    "twpas": {"$ref": "#/$defs/twpas_config"},
    "docx_template": {"type": "string", "description": "relative path of the Jinja2 docx application template"},
    "cohort": {"$ref": "#/$defs/cohort_config"},
    "population": {"$ref": "#/$defs/population_spec"},
    "nct_id": {"type": "string"},
    "terminology_release": {"type": "string", "pattern": "^TR-[0-9a-f]{12}$", "description": "the terminology release the ruleset was compiled against (D-301): a run against another release is refused until it is recompiled"},
    "prompt_pins": {"type": "object", "additionalProperties": {"$ref": "#/$defs/prompt_pin"}, "description": "the prompts the approved ruleset runs with, by prompt id (D-318): SCREEN runs the pinned version and text until the investigator re-approves; a newer registered version puts the study in approval needed"},
    "derived_pins": {"type": "object", "additionalProperties": {"$ref": "#/$defs/derived_pin"}, "description": "the score definitions the approved ruleset's criteria follow, by engine score (D-442): a definition of another version or text on the box puts the study in approval needed, and until then screening reads those scores as unknown"},
    "source_last_update": {"type": "string"},
    "terminology_refused": {"type": "array", "items": {"$ref": "#/$defs/refused_table"}, "description": "the installed code tables the compile could not read (E-TERM-3, D-1048): each by its table name and why; while one is a site list (site_*), approval is refused"}
  },
  "$defs": {
    "derived_pin": {
      "title": "DerivedPin",
      "description": "One score definition as the investigator approved it (D-442): the catalogue's def_version and the sha256 of its YAML.",
      "type": "object",
      "required": ["def_version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "def_version": {"type": "string", "pattern": "^[a-z0-9_.]+@[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "refused_table": {
      "title": "RefusedTable",
      "description": "One installed code table the compile could not read (E-TERM-3, D-1048): its table name (site_<name> for a site list) and the refusal's sentence, never a row of it.",
      "type": "object",
      "required": ["table", "reason"],
      "additionalProperties": false,
      "properties": {
        "table": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$"},
        "reason": {"type": "string", "maxLength": 600}
      }
    },
    "prompt_pin": {
      "title": "PromptPin",
      "description": "One prompt as the investigator approved it (D-318): the registry's version, text sha256 and output schema sha256.",
      "type": "object",
      "required": ["version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "scopes": {
      "title": "Scopes",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feas": {"$ref": "#/$defs/feas_scope"},
        "screen": {"$ref": "#/$defs/screen_scope"},
        "nav": {"$ref": "#/$defs/nav_scope"}
      }
    },
    "feas_scope": {
      "title": "FeasScope",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {"enum": ["hospital", "department"], "default": "hospital"},
        "departments": {"type": "array", "items": {"type": "string"}},
        "lookback_months": {"type": "integer", "minimum": 1, "maximum": 120, "default": 36}
      }
    },
    "screen_scope": {
      "title": "ScreenScope",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "practitioners": {"type": "array", "items": {"type": "string"}},
        "appointment_window_days": {"type": "integer", "default": 180},
        "departments": {"type": "array", "items": {"type": "string"}},
        "recent_encounter_months": {"type": "integer", "default": 12},
        "microbatch_window_days": {"type": "integer", "default": 14}
      }
    },
    "nav_scope": {
      "title": "NavScope",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "departments": {"type": "array", "items": {"type": "string"}},
        "appointment_window_days": {"type": "integer", "default": 14},
        "renewal_lead_days": {"type": "integer", "default": 42},
        "application_lookback_days": {"type": "integer", "default": 90}
      }
    },
    "routing": {
      "title": "Routing",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggregate_to": {"type": "array", "items": {"type": "string"}},
        "list_to": {"type": "array", "items": {"type": "string"}},
        "referral_to": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "thresholds": {
      "title": "RulesetThresholds",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier_high_confidence": {"type": "number", "default": 0.75},
        "small_cell": {"type": "integer", "default": 5}
      }
    },
    "models": {
      "title": "RulesetModels",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judge": {"type": "string"},
        "judge_prompt": {"type": "string"},
        "extract": {"type": "string"}
      }
    },
    "manifest_review": {
      "title": "ManifestReview",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string", "format": "date-time"},
        "approved_via": {"type": "string", "description": "'web console' or 'e-mail' (D-101)"},
        "rounds": {"type": "integer"},
        "split": {"$ref": "#/$defs/class_split"},
        "routing_confirmed": {"type": "boolean", "description": "the approver saw and confirmed the class (filter / model / person) of every criterion (D-101)"}
      }
    },
    "class_split": {
      "title": "ClassSplit",
      "description": "How many active criteria each class checks at approval time (D-101).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structured": {"type": "integer"},
        "mixed": {"type": "integer"},
        "note": {"type": "integer"},
        "human": {"type": "integer"}
      }
    },
    "population_spec": {
      "title": "PopulationSpec",
      "description": "The protocol's population in words the box can show next to every count: disease stage and study arm are explicit fields because a criteria list alone does not say that a dementia patient is out of an MCI trial (D-101).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disease_stage": {"type": "string", "description": "e.g. 'MCI or mild dementia due to AD (CDR 0.5–1)'"},
        "study_arm": {"type": "string", "description": "e.g. 'treatment-naive, first-line'"},
        "notes": {"type": "string"}
      }
    },
    "equivalence_summary": {
      "title": "EquivalenceSummary",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overall_pct": {"type": "number"},
        "sample_size": {"type": "integer"},
        "per_criterion": {"type": "object", "additionalProperties": {"type": "number"}},
        "failing": {"type": "array", "items": {"type": "string"}},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "twpas_config": {
      "title": "TwpasConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "program": {"type": "string"},
        "apply_type": {"type": "string", "description": "TWPAS application category (e.g. 1=new, 2=renewal)"},
        "drug_codes": {"type": "array", "items": {"type": "string"}},
        "precheck_library": {"type": "string"}
      }
    },
    "cohort_config": {
      "title": "CohortConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disease": {"type": "string"},
        "disease_label": {"type": "string"},
        "population_criterion": {"type": "string", "description": "criterion id that defines the disease cohort"},
        "combinations": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "ctgov_condition": {"type": "string"},
        "top_n_trials": {"type": "integer", "default": 3}
      }
    }
  }
}
