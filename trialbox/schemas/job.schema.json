{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trialbox.local/schemas/v1/job.schema.json",
  "title": "Job",
  "description": "A job record (SPEC 3.5). Schema version 1.2.0 (1.1.0: run_date; 1.2.0: metrics.prefilter, D-1259).",
  "type": "object",
  "required": ["job_id", "type", "requested_by", "received_at", "state"],
  "additionalProperties": false,
  "properties": {
    "job_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "type": {"$ref": "#/$defs/job_type"},
    "ruleset": {"type": ["string", "null"]},
    "ruleset_version": {"type": ["string", "null"]},
    "requested_by": {"type": "string"},
    "received_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "state": {"$ref": "#/$defs/job_state"},
    "snapshot_date": {"type": ["string", "null"], "format": "date"},
    "run_date": {"type": ["string", "null"], "format": "date", "description": "index/run date fixed when the job starts; reruns reuse it (reproducibility)"},
    "options": {"type": "object", "additionalProperties": {"type": "string"}},
    "comment": {"type": ["string", "null"]},
    "message_id": {"type": ["string", "null"], "description": "RFC 5322 Message-ID of the request mail"},
    "in_reply_to": {"type": ["string", "null"]},
    "parent_job_id": {"type": ["string", "null"]},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/job_file"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/job_output"}},
    "error": {"anyOf": [{"$ref": "#/$defs/job_error"}, {"type": "null"}]},
    "metrics": {"$ref": "#/$defs/job_metrics"}
  },
  "$defs": {
    "job_type": {"title": "JobType", "enum": ["FEAS", "SCREEN", "COHORT", "NAV", "APPROVE", "STATUS", "MICROBATCH", "INGEST", "SUBMIT", "FEEDBACK", "CANCEL", "RETENTION", "CALIBRATION", "CONSENT", "RELEASE", "CASE"]},
    "job_state": {"title": "JobState", "enum": ["received", "parsing", "compiling", "awaiting_approval", "running", "reporting", "done", "failed"]},
    "job_file": {
      "title": "JobFile",
      "type": "object",
      "required": ["filename", "sha256", "minio_key"],
      "additionalProperties": false,
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "minio_key": {"type": "string"},
        "content_type": {"type": "string"}
      }
    },
    "job_output": {
      "title": "JobOutput",
      "type": "object",
      "required": ["filename", "sha256", "minio_key", "recipients", "tag"],
      "additionalProperties": false,
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "minio_key": {"type": "string"},
        "recipients": {"type": "array", "items": {"type": "string"}},
        "tag": {"enum": ["aggregate", "phi"]}
      }
    },
    "job_error": {
      "title": "JobError",
      "type": "object",
      "required": ["step", "message"],
      "additionalProperties": false,
      "properties": {
        "step": {"type": "string"},
        "message": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "job_metrics": {
      "title": "JobMetrics",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patients_scoped": {"type": "integer", "default": 0},
        "llm_calls": {"type": "integer", "default": 0},
        "tokens_in": {"type": "integer", "default": 0},
        "tokens_out": {"type": "integer", "default": 0},
        "wall_seconds": {"type": "number", "default": 0},
        "step_seconds": {
          "description": "H-45: an APPROVE job's seconds by fixed step name (tb_common.steptime.APPROVE_STEPS), numbers only; on a done job they add up to wall_seconds with orch.unaccounted (a failed job writes no wall_seconds: its steps add up to that run's time). Optional: absent on other jobs.",
          "anyOf": [{"type": "object", "additionalProperties": {"type": "number"}}, {"type": "null"}]
        },
        "prefilter": {
          "description": "10E-12 (D-1259): a MICROBATCH job's pre-filter record, written when the job finishes: how many distinct patients the job had in scope and at which stage each left, each counted once at their last evaluation in the job. Counts only, never a patient id; the stages add up to in_scope. Optional: absent on other jobs.",
          "anyOf": [{"$ref": "#/$defs/prefilter_record"}, {"type": "null"}]
        }
      }
    },
    "prefilter_record": {
      "title": "PrefilterRecord",
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "in_scope", "opted_out", "not_due", "carried", "coded_excluded", "no_model", "model_not_listed", "listed"],
      "properties": {
        "trigger": {"type": "string", "enum": ["weekly", "ingest"]},
        "in_scope": {"type": "integer", "minimum": 0},
        "opted_out": {"type": "integer", "minimum": 0, "description": "on the opt-out register, refused research use or contact, or not at the index date (not in the snapshot, deceased or not yet born)"},
        "not_due": {"type": "integer", "minimum": 0, "description": "in scope, not looked at by this run by its cadence (no visit in the window, nothing to re-check, already screened)"},
        "carried": {"type": "integer", "minimum": 0, "description": "due and left by the night budget for a later run"},
        "coded_excluded": {"type": "integer", "minimum": 0, "description": "evaluated; a criterion the coded records decide was not met"},
        "no_model": {"type": "integer", "minimum": 0, "description": "evaluated, past the coded filter, not listed, and the model read no note for them"},
        "model_not_listed": {"type": "integer", "minimum": 0, "description": "evaluated, past the coded filter, the model read their notes, not listed"},
        "listed": {"type": "integer", "minimum": 0, "description": "evaluated and listed (high or review)"}
      }
    }
  }
}
