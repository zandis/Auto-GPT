{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trialbox.local/schemas/v1/candidate_list.schema.json",
  "title": "CandidateList",
  "description": "SPEC 3.6 candidate_list (tag phi). Schema version 1.4.0 (1.1.0: optional evidence.opinions, D-120; 1.2.0: optional evidence.coded, D-362; 1.3.0: optional criterion_verdict.final, D-476; 1.4.0: optional criterion_verdict.basis, D-478).",
  "type": "object",
  "required": ["ruleset", "version", "snapshot", "scope", "rows", "summary"],
  "additionalProperties": false,
  "properties": {
    "ruleset": {"type": "string"},
    "version": {"type": "string"},
    "snapshot": {"type": "string", "format": "date"},
    "run_date": {"type": "string", "format": "date"},
    "scope": {"$ref": "#/$defs/screen_run_scope"},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/candidate_row"}},
    "summary": {"$ref": "#/$defs/tier_summary"},
    "judging": {"$ref": "#/$defs/judging"}
  },
  "$defs": {
    "screen_run_scope": {
      "title": "ScreenRunScope",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "practitioners": {"type": "array", "items": {"type": "string"}},
        "departments": {"type": "array", "items": {"type": "string"}},
        "window_days": {"type": "integer"},
        "n_scoped": {"type": "integer"}
      }
    },
    "evidence": {
      "title": "Evidence",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_refs": {"type": "array", "items": {"type": "string"}},
        "quote": {"type": ["string", "null"]},
        "quote_date": {"type": ["string", "null"]},
        "confidence": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]},
        "opinions": {
          "description": "When the two checks disagree (D-120): each model's answer and its quote, so a person sees both.",
          "type": ["array", "null"],
          "items": {
            "title": "Opinion",
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "verdict"],
            "properties": {
              "role": {"type": "string", "enum": ["judge", "verifier"]},
              "verdict": {"type": "string"},
              "quote": {"type": ["string", "null"]},
              "quote_date": {"type": ["string", "null"]}
            }
          }
        },
        "coded_read": {
          "description": "D-653: false when the coded records behind this answer could not be read from the lake by the run that last looked (the answer stands; its values are not shown). Absent: they were read, or the answer has none.",
          "type": ["boolean", "null"]
        },
        "coded": {
          "description": "T-514 (D-362, review UX-008): the coded records behind the answer as a person checks them, latest first (at most three): the record's own value and unit, its date and its code. Shown beside the answer; never read by matching.",
          "type": ["array", "null"],
          "items": {
            "title": "CodedValue",
            "type": "object",
            "additionalProperties": false,
            "required": ["record", "domain"],
            "properties": {
              "record": {"type": "string"},
              "domain": {"type": "string"},
              "code": {"type": ["string", "null"]},
              "system": {"type": ["string", "null"]},
              "date": {"type": ["string", "null"]},
              "value": {"type": ["number", "null"]},
              "unit": {"type": ["string", "null"]},
              "value_code": {"type": ["string", "null"]},
              "comparator": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "criterion_verdict": {
      "title": "CriterionVerdict",
      "type": "object",
      "required": ["id", "verdict"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "verdict": {"enum": ["pass", "fail", "unknown", "pending_human"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "basis": {
          "description": "T-709 (D-478): what the answer rests on. coded: the patient's coded records; pair: two different models agreed; single: one model (or two clients of one model); person: a person decides or decided. Absent on an answer nobody gave (unknown) and on rows stored before the field.",
          "type": ["string", "null"],
          "enum": ["coded", "pair", "single", "person", null]
        },
        "final": {
          "description": "T-707 (D-476): on a note answer that says not met. false: given while a note answer was not allowed to exclude (one model, no second model that agreed, a shut canary gate); it never excludes the patient, on this run or at a later re-tier. true: it was allowed to exclude. Absent on every other verdict; a stored note fail without it is from before the field and never excludes.",
          "type": ["boolean", "null"]
        }
      }
    },
    "candidate_row": {
      "title": "CandidateRow",
      "type": "object",
      "required": ["pid", "tier", "criteria", "actions"],
      "additionalProperties": false,
      "properties": {
        "pid": {"type": "string"},
        "tier": {"enum": ["high", "review", "excluded"]},
        "next_appointment": {"type": ["string", "null"], "format": "date-time"},
        "practitioner_id": {"type": ["string", "null"]},
        "department": {"type": ["string", "null"]},
        "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion_verdict"}},
        "actions": {"type": "array", "items": {"type": "string"}},
        "n_unknown": {"type": "integer", "default": 0},
        "last_evaluated": {"type": ["string", "null"], "format": "date-time"},
        "changed": {"type": "array", "items": {"type": "string"}, "description": "microbatch: criterion ids whose verdict changed"},
        "coded_values": {"enum": ["not read", null], "description": "D-653: 'not read' when the values behind one or more of this row's coded answers could not be read from the lake by the run that last looked at the row (a carried row keeps it until a run reads the row again). Absent: read."}
      }
    },
    "judging": {
      "title": "Judging",
      "description": "How note criteria were judged on this run (D-97): models, agreement mode and whether a note answer could exclude a patient.",
      "type": "object",
      "required": ["mode", "note_block", "may_block"],
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["agreement", "single", "none"]},
        "judge_model": {"type": ["string", "null"]},
        "verifier_model": {"type": ["string", "null"]},
        "note_block": {"type": "string", "enum": ["both_agree", "never"]},
        "note_block_reason": {"type": "string"},
        "note_block_code": {"type": "string", "description": "Why a note answer could not exclude, as a code (ok when it could); the mail and the PDF say it in the reader's language."},
        "configured_note_block": {"type": "string", "enum": ["both_agree", "never"]},
        "may_block": {"type": "boolean"},
        "disagreements": {"type": "integer"},
        "failures": {"type": "integer"}
      }
    },
    "tier_summary": {
      "title": "TierSummary",
      "type": "object",
      "required": ["high", "review", "excluded"],
      "additionalProperties": false,
      "properties": {
        "high": {"type": "integer"},
        "review": {"type": "integer"},
        "excluded": {"type": "integer"},
        "coded_values_not_read": {"type": ["integer", "null"], "description": "D-653: how many rows of this list carry coded_values 'not read'. Absent: none."}
      }
    }
  }
}
