# TrialBox environment (SPEC §2). Copy to deploy/.env; readable by root only (chmod 600).
TB_SITE_ID=DEMO-A
TB_TZ=Asia/Taipei
COMPOSE_PROFILES=stub
TB_LLM_MODE=stub
TB_EMBED_MODE=hash
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_SSL=false
IMAP_USER=trialbox
IMAP_PASS=trialbox
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASS=
MAIL_INTAKE_ADDR=trialbox@hospa.test
MAIL_FROM_ADDR=trialbox@hospa.test
# first token of the Authentication-Results header the hospital MTA adds; other servers' headers are ignored
TB_MAIL_AUTHSERV_ID=mx.hospa.test
FHIR_BASE_URL=http://fhir-store:8080/fhir
LAKE_URL=http://lake:8013
EMBED_URL=http://embed-service:8014
LLM_BASE_URL=http://llm-service:8000/v1
LLM_MODEL=qwen3.5-35b-a3b-q4
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
TB_OBJECT_STORE=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=trialbox
MINIO_SECRET_KEY=change-me-minio-secret
NHI_TWPAS_BASE_URL=
ATTACH_PASSWORD_MODE=zip
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me-pg
TB_SETTINGS=/etc/trialbox/settings.yaml
