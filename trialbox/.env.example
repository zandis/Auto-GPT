# TrialBox environment (SPEC §2). Copy to deploy/.env; readable by root only (chmod 600).
TB_SITE_ID=DEMO-A
TB_TZ=Asia/Taipei
COMPOSE_PROFILES=stub
TB_LLM_MODE=stub
TB_EMBED_MODE=hash
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_SSL=false
IMAP_USER=trialbox
IMAP_PASS=trialbox
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASS=
MAIL_INTAKE_ADDR=trialbox@hospa.test
MAIL_FROM_ADDR=trialbox@hospa.test
# first token of the Authentication-Results header the hospital MTA adds; other servers' headers are ignored
TB_MAIL_AUTHSERV_ID=mx.hospa.test
FHIR_BASE_URL=http://fhir-store:8080/fhir
LAKE_URL=http://lake:8013
EMBED_URL=http://embed-service:8014
LLM_BASE_URL=http://llm-service:8000/v1
LLM_MODEL=qwen3.5-35b-a3b-q4
# DGX Spark (deploy/docker-compose.gb10.yml, docs/RUNBOOK.md section 8): judge + verifier served behind tb-gateway;
# defaults shown, sizes to be confirmed on the hardware. LLM_MODEL above is the legacy direct-client setting only.
# JUDGE_MODEL_DIR=gemma-4-26b-a4b-it-4bit
# JUDGE_MODEL=local/gemma-4-26b-a4b-nvfp4
# JUDGE_GPU_MEM_UTIL=0.30
# VERIFIER_MODEL_DIR=qwen3.5-9b-4bit
# VERIFIER_MODEL=local/qwen3.5-9b-awq
# VERIFIER_GPU_MEM_UTIL=0.15
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
# D-177: the key of the on-box model servers (vLLM VLLM_API_KEY); install.sh makes one in GPU mode. Empty: open.
TB_LLM_API_KEY=
# objects (attachments, outputs) on the shared objects-data volume; MinIO was removed (D-121)
TB_OBJECT_STORE=fs:/data/objects
# D-114: one shared service token, for the test stack and the PoC only (poc.sh generates it). A box installed with
# deploy/install.sh has one token per service instead (D-138, `trialbox secrets`; RUNBOOK §5 "Secrets")
TB_SERVICE_TOKEN=change-me-service-token
NHI_TWPAS_BASE_URL=
ATTACH_PASSWORD_MODE=zip
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me-pg
# workflow store (outbox, recall ledger); falls back to POSTGRES_PASSWORD when unset
POSTGRES_WF_PASSWORD=change-me-wf
# the one trial database of every service (D-126); install.sh and poc.sh rewrite it with the password above
TB_DB_URL=postgresql://trialbox:change-me-wf@db:5432/trialbox_wf
TB_SETTINGS=/etc/trialbox/settings.yaml
# D-151: where the lake's rows come from. legacy = flattened from the NDJSON (default for now); omop = loaded into
# the OMOP CDM v5.4 store of record (schema omop of TB_DB_URL) and exported from it. Flipped when parity holds.
TB_LAKE_SOURCE=legacy

# Test stack only (make up-test): host ports, all bound to 127.0.0.1. Uncomment and change any that is already taken
# on this machine; the tests, `make` targets and tools/send_test_mail.py read the same values.
# TB_HOST_FHIR_PORT=8080
# TB_HOST_GATEWAY_PORT=8020
# TB_HOST_ORCH_PORT=8010
# TB_HOST_PARSER_PORT=8011
# TB_HOST_COMPILER_PORT=8012
# TB_HOST_LAKE_PORT=8013
# TB_HOST_MAIL_GATEWAY_PORT=8015
# TB_HOST_ADAPTER_PORT=8016
# TB_HOST_MAILHOG_PORT=8025
# TB_HOST_SMTP_PORT=3025
# TB_HOST_IMAP_PORT=3143
# TB_HOST_WORKFLOW_DB_PORT=5433
# D-121: the console sends N1/N2 and runs the REDCap read-back itself (auto = on in VALIDATION/PRODUCTION)
# TB_CONSOLE_TIMERS=auto
# TB_NOTICE_N1_AT=07:00
# TB_NOTICE_N2_AT=07:30
# TB_REDCAP_READ_AT=03:00
