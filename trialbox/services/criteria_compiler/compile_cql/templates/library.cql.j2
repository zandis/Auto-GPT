library {{ library }} version '{{ version }}'

using FHIR version '4.0.1'

include FHIRHelpers version '4.0.1' called FHIRHelpers
include TB_Common version '1.0.0' called TB
{% for cs in codesystems %}
codesystem "{{ cs.name }}": '{{ cs.url }}'
{%- endfor %}
{% for c in codes %}
code "{{ c.name }}": '{{ c.code }}' from "{{ c.cs }}"
{%- endfor %}
{% for vs in valuesets %}
valueset "{{ vs.name }}": '{{ vs.url }}'{% if vs.version %} version '{{ vs.version }}'{% endif %}
{%- endfor %}

parameter IndexDate Date
parameter LookbackMonths Integer default {{ lookback }}

context Patient
{% for d in defines %}
{{ d }}
{% endfor %}
