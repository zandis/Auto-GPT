[
 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": false,
   "readOnlyHint": false,
   "tb/limit": "5/hour",
   "tb/roles": [
    "staff"
   ],
   "tb/tier": "T0"
  },
  "description": "Creates a typed request in state proposed; nothing runs until the sender confirms it. Types: FEAS (site feasibility: how many local patients meet a study's criteria over a look-back such as lookback=36m), SCREEN (candidate list for a study), ASK (protocol question), QFILL, MATCH, REPORT and others. Local patient counts come only from a confirmed FEAS request.",
  "inputSchema": {
   "$defs": {
    "RequestType": {
     "description": "Typed request kinds ``tb.submit_request`` may create (the grammar types of App. D).",
     "enum": [
      "FEAS",
      "QFILL",
      "SCREEN",
      "MATCH",
      "ASK",
      "REPORT",
      "CONFIG",
      "ABSTRACT",
      "WHATIF",
      "STUDY",
      "STATE",
      "CONFIRM",
      "REJECT",
      "DEFER",
      "MONITOR",
      "DIGEST"
     ],
     "title": "RequestType",
     "type": "string"
    }
   },
   "additionalProperties": false,
   "properties": {
    "language": {
     "default": "en",
     "enum": [
      "zh-TW",
      "en",
      "ja",
      "mixed"
     ],
     "title": "Language",
     "type": "string"
    },
    "params": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       }
      ]
     },
     "title": "Params",
     "type": "object"
    },
    "study": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "study code or NEW",
     "title": "Study"
    },
    "type": {
     "$ref": "#/$defs/RequestType"
    }
   },
   "required": [
    "type"
   ],
   "title": "SubmitRequestIn",
   "type": "object"
  },
  "name": "tb.submit_request",
  "outputSchema": {
   "additionalProperties": false,
   "properties": {
    "commands": {
     "items": {
      "type": "string"
     },
     "title": "Commands",
     "type": "array"
    },
    "confirm_instruction": {
     "title": "Confirm Instruction",
     "type": "string"
    },
    "expires_at": {
     "format": "date-time",
     "title": "Expires At",
     "type": "string"
    },
    "restatement": {
     "title": "Restatement",
     "type": "string"
    },
    "state": {
     "const": "proposed",
     "default": "proposed",
     "title": "State",
     "type": "string"
    },
    "ticket_id": {
     "title": "Ticket Id",
     "type": "string"
    }
   },
   "required": [
    "ticket_id",
    "commands",
    "restatement",
    "confirm_instruction",
    "expires_at"
   ],
   "title": "SubmitRequestOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": false,
   "readOnlyHint": true,
   "tb/limit": "60/hour",
   "tb/roles": [
    "staff"
   ],
   "tb/tier": "T1"
  },
  "description": "Request states, pending gates, due dates and control-rounded pipeline counts.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "study": {
     "anyOf": [
      {
       "maxLength": 16,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Study"
    },
    "ticket_id": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ticket Id"
    }
   },
   "title": "StatusIn",
   "type": "object"
  },
  "name": "tb.status",
  "outputSchema": {
   "$defs": {
    "RequestState": {
     "enum": [
      "proposed",
      "confirmed",
      "superseded",
      "expired",
      "withdrawn"
     ],
     "title": "RequestState",
     "type": "string"
    },
    "RequestType": {
     "description": "Typed request kinds ``tb.submit_request`` may create (the grammar types of App. D).",
     "enum": [
      "FEAS",
      "QFILL",
      "SCREEN",
      "MATCH",
      "ASK",
      "REPORT",
      "CONFIG",
      "ABSTRACT",
      "WHATIF",
      "STUDY",
      "STATE",
      "CONFIRM",
      "REJECT",
      "DEFER",
      "MONITOR",
      "DIGEST"
     ],
     "title": "RequestType",
     "type": "string"
    },
    "StatusItem": {
     "additionalProperties": false,
     "properties": {
      "due": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Due"
      },
      "next_gate": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Next Gate"
      },
      "state": {
       "$ref": "#/$defs/RequestState"
      },
      "study": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Study"
      },
      "ticket_id": {
       "title": "Ticket Id",
       "type": "string"
      },
      "type": {
       "$ref": "#/$defs/RequestType"
      }
     },
     "required": [
      "ticket_id",
      "type",
      "state"
     ],
     "title": "StatusItem",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "counts": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "string"
       }
      ]
     },
     "title": "Counts",
     "type": "object"
    },
    "items": {
     "items": {
      "$ref": "#/$defs/StatusItem"
     },
     "title": "Items",
     "type": "array"
    }
   },
   "required": [
    "items"
   ],
   "title": "StatusOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": false,
   "readOnlyHint": true,
   "tb/limit": "30/hour",
   "tb/roles": [
    "staff"
   ],
   "tb/tier": "T0"
  },
  "description": "Protocol answer with section citations, or a not-stated result.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "question": {
     "maxLength": 500,
     "minLength": 1,
     "title": "Question",
     "type": "string"
    },
    "study": {
     "pattern": "^[A-Z0-9][A-Z0-9_-]{0,15}$",
     "title": "Study",
     "type": "string"
    }
   },
   "required": [
    "study",
    "question"
   ],
   "title": "AskProtocolIn",
   "type": "object"
  },
  "name": "tb.ask_protocol",
  "outputSchema": {
   "additionalProperties": false,
   "properties": {
    "answer": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Answer"
    },
    "citations": {
     "items": {
      "type": "string"
     },
     "title": "Citations",
     "type": "array"
    },
    "not_stated": {
     "title": "Not Stated",
     "type": "boolean"
    }
   },
   "required": [
    "answer",
    "citations",
    "not_stated"
   ],
   "title": "AskProtocolOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": false,
   "readOnlyHint": true,
