   "tb/roles": [
    "staff"
   ],
   "tb/tier": "T0"
  },
  "description": "Search of the local public trial registry index (public trial records); it holds no local patient counts and no site rulesets.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "limit": {
     "default": 10,
     "maximum": 20,
     "minimum": 1,
     "title": "Limit",
     "type": "integer"
    },
    "query": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Query",
     "type": "string"
    }
   },
   "required": [
    "query"
   ],
   "title": "RegistrySearchIn",
   "type": "object"
  },
  "name": "tb.registry_search",
  "outputSchema": {
   "$defs": {
    "RegistryRecord": {
     "additionalProperties": false,
     "properties": {
      "conditions": {
       "items": {
        "type": "string"
       },
       "title": "Conditions",
       "type": "array"
      },
      "nct_id": {
       "title": "Nct Id",
       "type": "string"
      },
      "phases": {
       "items": {
        "type": "string"
       },
       "title": "Phases",
       "type": "array"
      },
      "status": {
       "title": "Status",
       "type": "string"
      },
      "title": {
       "title": "Title",
       "type": "string"
      }
     },
     "required": [
      "nct_id",
      "title",
      "status"
     ],
     "title": "RegistryRecord",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "records": {
     "items": {
      "$ref": "#/$defs/RegistryRecord"
     },
     "title": "Records",
     "type": "array"
    }
   },
   "required": [
    "records"
   ],
   "title": "RegistrySearchOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": false,
   "readOnlyHint": true,
   "tb/limit": "30/hour",
   "tb/roles": [
    "steward",
    "research_office",
    "admin"
   ],
   "tb/tier": "T1"
  },
  "description": "Data coverage, freshness, data-quality scorecard and computability rows, rounded.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "domain": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Domain"
    }
   },
   "title": "AtlasDescribeIn",
   "type": "object"
  },
  "name": "tb.atlas_describe",
  "outputSchema": {
   "$defs": {
    "AtlasRow": {
     "additionalProperties": false,
     "properties": {
      "computable": {
       "title": "Computable",
       "type": "boolean"
      },
      "coverage_pct": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "title": "Coverage Pct"
      },
      "domain": {
       "title": "Domain",
       "type": "string"
      },
      "dq_status": {
       "enum": [
