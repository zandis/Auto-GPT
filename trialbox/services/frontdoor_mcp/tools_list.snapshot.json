     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "rows": {
     "items": {
      "$ref": "#/$defs/AtlasRow"
     },
     "title": "Rows",
     "type": "array"
    },
    "snapshot": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Snapshot"
    }
   },
   "required": [
    "snapshot",
    "rows"
   ],
   "title": "AtlasDescribeOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": false,
   "readOnlyHint": true,
   "tb/limit": "20/hour",
   "tb/roles": [
    "research_office",
    "pi",
    "crc"
   ],
   "tb/tier": "T1"
  },
  "description": "Catalogue metrics as a control-rounded table with suppression marks and an accountant entry.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "breakdown": {
     "anyOf": [
      {
       "pattern": "^[a-z][a-z0-9_]{0,31}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Breakdown"
    },
    "metric": {
     "pattern": "^[a-z][a-z0-9_]{0,47}$",
     "title": "Metric",
     "type": "string"
    },
    "study": {
     "anyOf": [
      {
       "pattern": "^[A-Z0-9][A-Z0-9_-]{0,15}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Study"
    }
   },
   "required": [
    "metric"
   ],
   "title": "AggregateQueryIn",
   "type": "object"
  },
  "name": "tb.aggregate_query",
  "outputSchema": {
   "$defs": {
    "AggregateRow": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "title": "Key",
       "type": "string"
      },
      "suppressed": {
       "title": "Suppressed",
       "type": "boolean"
      },
      "value": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        }
       ],
       "title": "Value"
      }
     },
     "required": [
      "key",
      "value",
      "suppressed"
     ],
     "title": "AggregateRow",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "accountant_entry_id": {
     "title": "Accountant Entry Id",
     "type": "string"
    },
    "breakdown": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Breakdown"
    },
    "data_cut": {
     "title": "Data Cut",
     "type": "string"
    },
    "metric": {
     "title": "Metric",
     "type": "string"
    },
    "rows": {
     "items": {
      "$ref": "#/$defs/AggregateRow"
     },
     "title": "Rows",
     "type": "array"
    }
   },
   "required": [
    "metric",
    "breakdown",
    "rows",
    "data_cut",
    "accountant_entry_id"
   ],
   "title": "AggregateQueryOut",
   "type": "object"
  }
 },
 {
