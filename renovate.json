{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "TrialBox dependency policy (plan v6 section 9.3, DEP-019). Monthly grouped PRs, digests pinned, no automerge.",
    "The security owner approves every PR. vLLM, model images and the PostgreSQL major carry the requalify label.",
    "uv.lock moves through pep621 and lockFileMaintenance; deploy/requirements.lock and the pip-audit lock are",
    "regenerated by `make lock` on the PR branch, and `make lock-check` fails the PR until that is done.",
    "A validator, Syft or Trivy version bump leaves the old sha256 in place, so the fetch fails until the sums are updated."
  ],
  "extends": [
    "config:recommended",
    ":pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Taipei",
  "includePaths": [
    "trialbox/**",
    ".github/workflows/trialbox-*.yml"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "trialbox/.venv/**",
    "trialbox/.cache/**",
    "trialbox/deploy/requirements.lock",
    "trialbox/tools/supply_chain/pip-audit.lock"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "platformAutomerge": false,
  "schedule": [
    "* 0-5 1 * *"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-5 1 * *"
    ],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ],
    "automerge": false
  },
  "osvVulnerabilityAlerts": true,
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "Python packages outside the runtime lock (extras, dev, test)",
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python-dev",
      "schedule": [
        "* 0-5 1 * *"
      ]
    },
    {
      "description": "Python packages in deploy/requirements.lock (what the images install)",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "annotated-doc",
        "annotated-types",
        "anyio",
        "apscheduler",
        "attrs",
        "backports-zstd",
        "brotli",
        "brotlicffi",
        "certifi",
        "cffi",
        "charset-normalizer",
        "click",
        "contourpy",
        "cryptography",
        "cycler",
        "docxtpl",
        "duckdb",
        "duckdb-extension-fts",
        "dulwich",
        "et-xmlfile",
        "fastapi",
        "fhir-core",
        "fhir-resources",
        "fonttools",
        "h11",
        "httpcore",
        "httpx",
        "idna",
        "inflate64",
        "jinja2",
        "jsonschema",
        "jsonschema-specifications",
        "kiwisolver",
        "lxml",
        "markdown",
        "markupsafe",
        "matplotlib",
        "multivolumefile",
        "numpy",
        "openpyxl",
        "opentelemetry-api",
        "packaging",
        "pillow",
        "psutil",
        "psycopg",
        "psycopg-binary",
        "py7zr",
        "pyarrow",
        "pybcj",
        "pycparser",
        "pycryptodomex",
        "pydantic",
        "pydantic-core",
        "pyparsing",
        "pypdf",
        "pyppmd",
        "python-dateutil",
        "python-docx",
        "python-multipart",
        "pyyaml",
        "referencing",
        "reportlab",
        "rpds-py",
        "sqlalchemy",
        "sqlglot",
        "starlette",
        "texttable",
        "typing-extensions",
        "typing-inspection",
        "tzdata",
        "tzlocal",
        "urllib3",
        "uvicorn",
        "zstandard"
      ],
      "groupName": "python-runtime",
      "schedule": [
        "* 0-5 1 * *"
      ]
    },
    {
      "description": "GitHub Actions, pinned by commit SHA with the version in a comment",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "actions",
      "schedule": [
        "* 0-5 1 * *"
      ]
    },
    {
      "description": "The CQL translator pom and the HL7 validator",
      "matchManagers": [
        "maven"
      ],
      "groupName": "jvm",
      "schedule": [
        "* 0-5 1 * *"
      ]
    },
    {
      "matchDepNames": [
        "hapifhir/org.hl7.fhir.core"
      ],
      "groupName": "jvm",
      "schedule": [
        "* 0-5 1 * *"
      ]
    },
    {
      "description": "Build tools: uv in CI and lock.py move together; pip-audit, Syft and Trivy with their sums",
      "matchDepNames": [
        "uv",
        "pip-audit",
        "anchore/syft",
        "aquasecurity/trivy"
      ],
      "groupName": "build-tools",
      "schedule": [
        "* 0-5 1 * *"
      ]
    },
    {
      "description": "Model serving and the database major need requalification (WS-02.2) before merge",
      "matchPackageNames": [
        "vllm/vllm-openai",
        "/^eugr\\//"
      ],
      "addLabels": [
        "requalify"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "postgres",
        "docker.io/library/postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "requalify"
      ],
      "automerge": false
    },
    {
      "description": "Major updates: their own PRs, labelled",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "uv pinned in CI",
      "managerFilePatterns": [
        "/^\\.github/workflows/trialbox-.+\\.yml$/"
      ],
      "matchStrings": [
        "setup-uv@[0-9a-f]{40}\\s+#[^\\n]*\\n\\s+with:\\n\\s+version: \"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "uv and pip-audit pinned in tools/supply_chain/lock.py",
      "managerFilePatterns": [
        "/^trialbox/tools/supply_chain/lock\\.py$/"
      ],
      "matchStrings": [
        "\\nUV_VERSION = \"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^trialbox/tools/supply_chain/lock\\.py$/"
      ],
      "matchStrings": [
        "PIP_AUDIT_VERSION = \"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "pip-audit",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^trialbox/tools/supply_chain/pip-audit\\.in$/"
      ],
      "matchStrings": [
        "pip-audit==(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "pip-audit",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Syft and Trivy in tools/supply_chain/scanners.py (the sums are updated by hand)",
      "managerFilePatterns": [
        "/^trialbox/tools/supply_chain/scanners\\.py$/"
      ],
      "matchStrings": [
        "SYFT_VERSION = \"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "anchore/syft",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^trialbox/tools/supply_chain/scanners\\.py$/"
      ],
      "matchStrings": [
        "TRIVY_VERSION = \"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "HL7 validator CLI in tools/fetch_jvm_deps.sh (the sha256 is updated by hand)",
      "managerFilePatterns": [
        "/^trialbox/tools/fetch_jvm_deps\\.sh$/"
      ],
      "matchStrings": [
        "PINNED_VALIDATOR_VERSION=\"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "hapifhir/org.hl7.fhir.core",
      "datasourceTemplate": "github-releases"
    }
  ]
}
