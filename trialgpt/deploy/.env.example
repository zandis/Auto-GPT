# Copy to .env (never commit it). Values below are examples.
TG_DOMAIN=trialgpt.example.org          # DNS A record -> this server's public IP (ports 80 + 443 open)
TG_USER=pi
# bcrypt hash of the password: docker run --rm caddy:2.10 caddy hash-password --plaintext 'your-password'
# write every $ as $$ in this file (compose substitution)
TG_PASSWORD_HASH=
TG_LLM_MODEL=gemma4:12b                 # gemma4:31b on a 24 GB+ GPU
TG_LLM_NUM_CTX=16384
TG_LLM_TIMEOUT=3600
